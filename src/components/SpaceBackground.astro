<div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <!-- Top Spotlight Cone (Linear/Apple style radiant beam) -->
    <div
        class="absolute -top-[20%] left-1/2 -translate-x-1/2 w-[800px] sm:w-[1100px] h-[500px] sm:h-[650px] bg-gradient-to-b from-primary-500/20 via-cyan-500/10 to-transparent rounded-full blur-[100px] sm:blur-[140px] pointer-events-none"
    >
    </div>

    <!-- Interactive Particle Grid Mesh Canvas -->
    <canvas id="space-canvas" class="absolute inset-0 w-full h-full opacity-75 dark:opacity-65 transition-opacity duration-500"></canvas>
</div>

<script>
    class ModernCyberCanvas {
        canvas: HTMLCanvasElement;
        ctx: CanvasRenderingContext2D;
        width = 0;
        height = 0;
        dpr = 1;
        nodes: Array<{
            x: number;
            y: number;
            vx: number;
            vy: number;
            baseSize: number;
            size: number;
            color: string;
            alpha: number;
            pulsePhase: number;
        }> = [];
        mouse = { x: -1000, y: -1000, targetX: -1000, targetY: -1000 };
        isHovering = false;
        animId: number | null = null;
        isDark = true;

        darkColors = [
            '#818cf8', // Indigo
            '#06b6d4', // Cyan
            '#a78bfa', // Purple
            '#38bdf8', // Sky
            '#ffffff', // White
        ];

        lightColors = [
            '#4f46e5', // Indigo
            '#0891b2', // Cyan
            '#7c3aed', // Purple
            '#0284c7', // Sky
            '#475569', // Slate
        ];

        constructor(canvas: HTMLCanvasElement) {
            this.canvas = canvas;
            this.ctx = canvas.getContext('2d', { alpha: true })!;
            this.checkTheme();
            this.init();
        }

        checkTheme() {
            this.isDark = document.documentElement.classList.contains('dark');
        }

        get currentColors() {
            return this.isDark ? this.darkColors : this.lightColors;
        }

        init() {
            this.resize();
            this.createNodes();
            this.bindEvents();
            this.animate();
        }

        resize() {
            this.dpr = Math.min(window.devicePixelRatio || 1, 2);
            this.width = this.canvas.parentElement?.clientWidth || window.innerWidth;
            this.height = this.canvas.parentElement?.clientHeight || window.innerHeight;

            this.canvas.width = this.width * this.dpr;
            this.canvas.height = this.height * this.dpr;
            this.ctx.scale(this.dpr, this.dpr);
        }

        createNodes() {
            this.nodes = [];
            const count = Math.min(Math.floor((this.width * this.height) / 12000), 110);
            const palette = this.currentColors;

            for (let i = 0; i < count; i++) {
                const color = palette[Math.floor(Math.random() * palette.length)];
                const baseSize = Math.random() * 1.5 + 0.8;
                this.nodes.push({
                    x: Math.random() * this.width,
                    y: Math.random() * this.height,
                    vx: (Math.random() - 0.5) * 0.35,
                    vy: (Math.random() - 0.5) * 0.35,
                    baseSize,
                    size: baseSize,
                    color,
                    alpha: Math.random() * 0.4 + (this.isDark ? 0.3 : 0.4),
                    pulsePhase: Math.random() * Math.PI * 2,
                });
            }
        }

        updatePalette() {
            this.checkTheme();
            const palette = this.currentColors;
            this.nodes.forEach(node => {
                node.color = palette[Math.floor(Math.random() * palette.length)];
            });
        }

        bindEvents() {
            window.addEventListener('resize', () => {
                this.resize();
                this.createNodes();
            });

            window.addEventListener('mousemove', (e) => {
                const rect = this.canvas.getBoundingClientRect();
                this.mouse.targetX = e.clientX - rect.left;
                this.mouse.targetY = e.clientY - rect.top;
                this.isHovering = true;
            });

            document.addEventListener('mouseleave', () => {
                this.isHovering = false;
                this.mouse.targetX = -1000;
                this.mouse.targetY = -1000;
            });

            window.addEventListener('theme-changed', () => {
                this.updatePalette();
            });

            const observer = new MutationObserver(() => {
                this.updatePalette();
            });
            observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
        }

        animate() {
            this.mouse.x += (this.mouse.targetX - this.mouse.x) * 0.08;
            this.mouse.y += (this.mouse.targetY - this.mouse.y) * 0.08;

            this.ctx.clearRect(0, 0, this.width, this.height);

            const connectDist = Math.min(140, this.width * 0.16);
            const mouseRadius = 180;
            const now = Date.now() * 0.002;
            const strokeColor = this.isDark ? '#818cf8' : '#6366f1';

            for (let i = 0; i < this.nodes.length; i++) {
                const node = this.nodes[i];

                node.x += node.vx;
                node.y += node.vy;

                if (node.x < 0) { node.x = 0; node.vx *= -1; }
                if (node.x > this.width) { node.x = this.width; node.vx *= -1; }
                if (node.y < 0) { node.y = 0; node.vy *= -1; }
                if (node.y > this.height) { node.y = this.height; node.vy *= -1; }

                const dxm = node.x - this.mouse.x;
                const dym = node.y - this.mouse.y;
                const distMouse = Math.hypot(dxm, dym);

                let cursorInfluence = 0;
                if (distMouse < mouseRadius) {
                    cursorInfluence = 1 - distMouse / mouseRadius;
                    const angle = Math.atan2(dym, dxm);
                    node.x += Math.cos(angle) * cursorInfluence * 0.6;
                    node.y += Math.sin(angle) * cursorInfluence * 0.6;
                }

                const pulse = Math.sin(now + node.pulsePhase) * 0.3;
                node.size = node.baseSize * (1 + pulse) + cursorInfluence * 1.5;

                this.ctx.beginPath();
                this.ctx.arc(node.x, node.y, Math.max(0.5, node.size), 0, Math.PI * 2);
                this.ctx.fillStyle = node.color;
                this.ctx.globalAlpha = Math.min(1, node.alpha + cursorInfluence * 0.5);
                this.ctx.fill();

                if (cursorInfluence > 0.4) {
                    this.ctx.beginPath();
                    this.ctx.arc(node.x, node.y, node.size * 2.5, 0, Math.PI * 2);
                    this.ctx.fillStyle = node.color;
                    this.ctx.globalAlpha = cursorInfluence * 0.2;
                    this.ctx.fill();
                }

                for (let j = i + 1; j < this.nodes.length; j++) {
                    const other = this.nodes[j];
                    const dx = node.x - other.x;
                    const dy = node.y - other.y;
                    const dist = Math.hypot(dx, dy);

                    if (dist < connectDist) {
                        const alpha = (1 - dist / connectDist) * (this.isDark ? 0.18 : 0.22);
                        this.ctx.beginPath();
                        this.ctx.moveTo(node.x, node.y);
                        this.ctx.lineTo(other.x, other.y);
                        this.ctx.strokeStyle = strokeColor;
                        this.ctx.globalAlpha = alpha + cursorInfluence * 0.2;
                        this.ctx.lineWidth = 0.6;
                        this.ctx.stroke();
                    }
                }
            }

            this.ctx.globalAlpha = 1;
            this.animId = requestAnimationFrame(this.animate.bind(this));
        }
    }

    function initCanvas() {
        const canvas = document.getElementById('space-canvas') as HTMLCanvasElement;
        if (canvas) {
            new ModernCyberCanvas(canvas);
        }
    }

    document.addEventListener('astro:page-load', initCanvas);
    document.addEventListener('DOMContentLoaded', initCanvas);
</script>
