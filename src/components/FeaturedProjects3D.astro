---
interface Project {
    slug: string;
    data: {
        title: string;
        description: string;
        is_featured?: boolean;
        tech_stack: string[];
        demo_url?: string | null;
        github_url?: string | null;
        order?: number;
        thumbnail?: string;
    };
}

interface Props {
    projects: Project[];
}

const { projects } = Astro.props;
---

<div class="featured-3d-wrapper relative w-full select-none py-6 lg:py-10" id="featured-3d-experience">
    <!-- Ambient 3D Room Lighting & Lasers -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden -z-10">
        <!-- Overhead Spotlights -->
        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[650px] sm:w-[850px] h-[350px] bg-gradient-to-b from-primary-500/20 via-cyan-500/10 to-transparent blur-[120px] rounded-full"></div>
        <div class="absolute top-1/4 -left-20 w-[450px] h-[450px] bg-purple-600/15 blur-[130px] rounded-full"></div>
        <div class="absolute top-1/3 -right-20 w-[450px] h-[450px] bg-cyan-500/15 blur-[130px] rounded-full"></div>
        
        <!-- Subtle Top Grid Floor (Ceiling Horizon) -->
        <div class="absolute top-0 inset-x-0 h-24 bg-gradient-to-b from-slate-200/40 dark:from-cyan-950/20 to-transparent opacity-60"></div>
    </div>

    <!-- Header Section with Mode Switcher -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 sm:mb-14 gap-6 px-4 sm:px-6 max-w-7xl mx-auto">
        <div data-aos="fade-right">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 dark:bg-cyan-400/10 border border-cyan-500/20 dark:border-cyan-400/20 mb-3.5 backdrop-blur-md">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500 shadow-[0_0_8px_rgba(6,182,212,0.9)]"></span>
                </span>
                <span class="text-xs font-mono font-bold tracking-widest text-cyan-700 dark:text-cyan-300 uppercase">
                    3D SPATIAL SHOWROOM
                </span>
            </div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black font-display text-slate-900 dark:text-white tracking-tight">
                Featured <span class="text-transparent bg-clip-text bg-neon-gradient">Creations</span>
            </h2>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 font-normal mt-2 max-w-lg">
                Step into an interactive 3D spatial gallery. Drag, swipe, or use controls to inspect flagship engineering projects.
            </p>
        </div>

        <!-- Controls: View Toggle & View All Link -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 w-full md:w-auto justify-between md:justify-end" data-aos="fade-left">
            <!-- View Mode Switcher -->
            <div class="inline-flex p-1 rounded-2xl bg-slate-200/80 dark:bg-slate-900/80 border border-slate-300/80 dark:border-white/10 backdrop-blur-xl shadow-inner">
                <button
                    type="button"
                    id="btn-mode-deck"
                    class="mode-btn active flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all duration-300 shadow-sm"
                    title="3D Holo-Deck Stage View"
                >
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                    <span>3D Stage</span>
                </button>
                <button
                    type="button"
                    id="btn-mode-grid"
                    class="mode-btn flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all duration-300"
                    title="3D Spatial Matrix Grid"
                >
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    <span>Spatial Grid</span>
                </button>
            </div>

            <!-- View All Archive -->
            <a
                href="/projects"
                class="group inline-flex items-center gap-2 px-4 py-2 rounded-2xl border border-slate-300/80 dark:border-white/10 bg-white/70 dark:bg-white/5 hover:border-primary-500/50 hover:bg-primary-500/10 text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 backdrop-blur-md transition-all duration-300 shadow-xs hover:shadow-cyan-500/20"
            >
                <span>All Archive</span>
                <span class="text-xs font-mono text-primary-500 font-bold">({projects.length}+)</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
            </a>
        </div>
    </div>

    <!-- ========================================================= -->
    <!-- 1. 3D HOLO-DECK STAGE VIEW (THE SPATIAL CAROUSEL ROOM) -->
    <!-- ========================================================= -->
    <div id="view-deck-container" class="relative w-full max-w-[1400px] mx-auto transition-opacity duration-500">
        <!-- 3D Room Stage Viewport -->
        <div
            id="room-viewport"
            class="relative w-full h-[520px] sm:h-[580px] md:h-[620px] overflow-hidden flex items-center justify-center cursor-grab active:cursor-grabbing touch-none select-none"
            style="perspective: 1300px;"
        >
            <!-- Cybernetic 3D Floor Grid in Spatial Perspective -->
            <div class="spatial-floor pointer-events-none">
                <div class="floor-grid"></div>
                <div class="floor-glow"></div>
                <!-- Dynamic Center Stage Pedestal Light -->
                <div id="stage-podium-glow" class="stage-podium"></div>
            </div>

            <!-- 3D Parallax Stage (Pitches and Yaws with Mouse / Device) -->
            <div
                id="room-stage"
                class="relative w-full h-full flex items-center justify-center transform-style-3d will-change-transform"
                style="transform: rotateX(0deg) rotateY(0deg);"
            >
                <!-- Project 3D Cards Track -->
                {projects.map((project, index) => {
                    const techList = project.data.tech_stack || [];
                    const paddedIndex = String(index + 1).padStart(2, '0');
                    return (
                        <article
                            class="spatial-card absolute w-[88vw] max-w-[340px] sm:max-w-[400px] md:max-w-[460px] h-[440px] sm:h-[480px] md:h-[510px] rounded-[28px] transform-style-3d cursor-pointer transition-[transform,opacity,filter] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
                            data-index={index}
                            data-slug={project.slug}
                            style="transform: translate3d(0, 0, -500px) scale(0.6); opacity: 0; pointer-events: none;"
                        >
                            <!-- Card Base Glass Chassis with Futuristic Chamfer -->
                            <div class="chassis-body relative w-full h-full rounded-[28px] p-4 sm:p-5 flex flex-col justify-between overflow-hidden border backdrop-blur-2xl transition-all duration-300">
                                <!-- Top Prismatic Foil Accent Bar -->
                                <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-cyan-400 via-primary-500 to-purple-500 shadow-[0_0_12px_rgba(6,182,212,0.8)]"></div>

                                <!-- Specular Glare Layer that follows pointer -->
                                <div class="card-glare absolute inset-0 pointer-events-none opacity-0 transition-opacity duration-200 rounded-[28px]"></div>

                                <!-- Background Subtle Circuit/Grid Pattern -->
                                <div class="absolute inset-0 bg-[radial-gradient(rgba(148,163,184,0.12)_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>

                                <!-- ================= CARD HEADER ================= -->
                                <div class="relative z-10 flex items-center justify-between border-b border-slate-200/80 dark:border-white/10 pb-3">
                                    <!-- Left: Mini Browser Traffic Dots & Node ID -->
                                    <div class="flex items-center gap-2">
                                        <div class="flex gap-1.5">
                                            <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
                                            <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                                        </div>
                                        <span class="ml-2 text-[10px] font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400 font-semibold">
                                            NODE-{paddedIndex}
                                        </span>
                                    </div>

                                    <!-- Right: Holo Badge Indicator -->
                                    <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-slate-200/60 dark:bg-white/10 border border-slate-300/60 dark:border-white/15">
                                        <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 shadow-[0_0_6px_rgba(6,182,212,0.8)]"></span>
                                        <span class="text-[9px] font-mono font-bold tracking-wider text-slate-700 dark:text-cyan-300 uppercase">
                                            FEATURED #{paddedIndex}
                                        </span>
                                    </div>
                                </div>

                                <!-- ================= CARD MEDIA SCREEN (3D POP-OUT) ================= -->
                                <div class="relative z-10 w-full my-3 sm:my-3.5 rounded-2xl overflow-hidden border border-slate-200/90 dark:border-white/15 bg-slate-900/90 shadow-2xl group/media aspect-[16/9.5] transform-style-3d">
                                    {project.data.thumbnail ? (
                                        <img
                                            src={project.data.thumbnail}
                                            alt={project.data.title}
                                            class="w-full h-full object-cover object-top transition-transform duration-700 group-hover/media:scale-105"
                                            loading="lazy"
                                        />
                                    ) : (
                                        <div class="relative w-full h-full bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-950 flex flex-col items-center justify-center p-4 overflow-hidden">
                                            <!-- Cyberpunk Code Lines Grid -->
                                            <div class="absolute inset-0 opacity-20 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:14px_14px]"></div>
                                            <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-400/30 flex items-center justify-center text-cyan-300 mb-2 shadow-[0_0_20px_rgba(6,182,212,0.3)]">
                                                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                                    <polyline points="2 17 12 22 22 17"></polyline>
                                                    <polyline points="2 12 12 17 22 12"></polyline>
                                                </svg>
                                            </div>
                                            <span class="text-xs font-mono font-bold text-slate-300 tracking-wider">SYSTEM ARCHITECTURE</span>
                                        </div>
                                    )}

                                    <!-- Hologram Scanlines Overlay -->
                                    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-cyan-500/[0.04] to-transparent bg-[length:100%_4px] pointer-events-none"></div>
                                    <div class="absolute inset-0 rounded-2xl border border-white/10 pointer-events-none"></div>
                                </div>

                                <!-- ================= CARD CONTENT & METADATA ================= -->
                                <div class="relative z-10 flex flex-col gap-2.5">
                                    <!-- Tech Stack Badges (Floating Depth Pills) -->
                                    <div class="flex flex-wrap gap-1.5 max-h-12 overflow-hidden">
                                        {techList.slice(0, 4).map((tech) => (
                                            <span class="text-[10px] sm:text-[11px] font-mono font-semibold px-2.5 py-0.5 rounded-lg bg-slate-100/90 dark:bg-slate-800/80 text-primary-700 dark:text-cyan-300 border border-slate-200 dark:border-white/10 shadow-xs">
                                                {tech}
                                            </span>
                                        ))}
                                        {techList.length > 4 && (
                                            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-white/10">
                                                +{techList.length - 4}
                                            </span>
                                        )}
                                    </div>

                                    <!-- Title -->
                                    <h3 class="text-lg sm:text-xl font-bold font-display text-slate-900 dark:text-white leading-snug line-clamp-1">
                                        {project.data.title}
                                    </h3>

                                    <!-- Description -->
                                    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">
                                        {project.data.description}
                                    </p>
                                </div>

                                <!-- ================= ACTION BUTTONS FOOTER ================= -->
                                <div class="relative z-10 pt-3 mt-1 border-t border-slate-200/80 dark:border-white/10 flex items-center justify-between gap-3">
                                    <a
                                        href={`/projects/${project.slug}`}
                                        class="primary-action-btn flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-primary-600 via-indigo-600 to-cyan-600 text-white font-semibold text-xs sm:text-sm shadow-md hover:shadow-cyan-500/30 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
                                    >
                                        <span>Case Study</span>
                                        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M5 12h14M12 5l7 7-7 7"/>
                                        </svg>
                                    </a>

                                    {project.data.github_url && (
                                        <a
                                            href={project.data.github_url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="inline-flex items-center justify-center p-2.5 rounded-xl border border-slate-300/80 dark:border-white/15 bg-slate-100/80 dark:bg-white/5 hover:bg-slate-200 dark:hover:bg-white/15 text-slate-700 dark:text-slate-200 transition-all duration-200"
                                            title="View Source on GitHub"
                                        >
                                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                                                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                                            </svg>
                                        </a>
                                    )}

                                    {project.data.demo_url && (
                                        <a
                                            href={project.data.demo_url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="inline-flex items-center justify-center p-2.5 rounded-xl border border-cyan-500/30 bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-600 dark:text-cyan-300 transition-all duration-200"
                                            title="Live Demo"
                                        >
                                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                                <polyline points="15 3 21 3 21 9"></polyline>
                                                <line x1="10" y1="14" x2="21" y2="3"></line>
                                            </svg>
                                        </a>
                                    )}
                                </div>
                            </div>
                        </article>
                    );
                })}
            </div>

            <!-- Left & Right Floating Spatial Navigation Portals -->
            <button
                type="button"
                id="btn-stage-prev"
                class="stage-nav-btn absolute left-2 sm:left-6 md:left-10 z-40 w-11 sm:w-13 h-11 sm:h-13 rounded-2xl flex items-center justify-center backdrop-blur-xl border transition-all duration-300 shadow-xl group"
                aria-label="Previous project"
            >
                <svg class="w-5 h-5 text-slate-700 dark:text-slate-200 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
                </svg>
            </button>

            <button
                type="button"
                id="btn-stage-next"
                class="stage-nav-btn absolute right-2 sm:right-6 md:right-10 z-40 w-11 sm:w-13 h-11 sm:h-13 rounded-2xl flex items-center justify-center backdrop-blur-xl border transition-all duration-300 shadow-xl group"
                aria-label="Next project"
            >
                <svg class="w-5 h-5 text-slate-700 dark:text-slate-200 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                </svg>
            </button>
        </div>

        <!-- ========================================================= -->
        <!-- BOTTOM SPATIAL CONTROL BAR (PROGRESS & BULLETS) -->
        <!-- ========================================================= -->
        <div class="mt-4 sm:mt-6 px-4 max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
            <!-- Project Counter Display -->
            <div class="flex items-center gap-2 font-mono text-xs text-slate-600 dark:text-slate-400">
                <span class="font-bold text-sm text-primary-600 dark:text-cyan-400" id="current-index-display">01</span>
                <span class="opacity-40">/</span>
                <span class="opacity-60">{String(projects.length).padStart(2, '0')}</span>
                <span class="text-[11px] font-sans font-medium text-slate-500 dark:text-slate-500 ml-2 hidden sm:inline" id="active-title-preview">
                    {projects[0]?.data.title}
                </span>
            </div>

            <!-- Bullet Track Indicator -->
            <div class="flex items-center gap-2" id="bullets-track">
                {projects.map((project, idx) => (
                    <button
                        type="button"
                        class="stage-bullet relative h-2.5 rounded-full transition-all duration-300 cursor-pointer"
                        data-target-index={idx}
                        title={`Jump to ${project.data.title}`}
                        style={idx === 0 ? "width: 2rem; background: linear-gradient(90deg, #06b6d4, #8b5cf6);" : "width: 0.625rem; background: rgba(148, 163, 184, 0.4);"}
                    >
                    </button>
                ))}
            </div>

            <!-- Keyboard & Gesture hint -->
            <div class="hidden md:flex items-center gap-2 text-[11px] font-mono text-slate-400 dark:text-slate-500">
                <kbd class="px-1.5 py-0.5 rounded-md bg-slate-200/80 dark:bg-slate-800 border border-slate-300 dark:border-white/10 shadow-2xs">←</kbd>
                <kbd class="px-1.5 py-0.5 rounded-md bg-slate-200/80 dark:bg-slate-800 border border-slate-300 dark:border-white/10 shadow-2xs">→</kbd>
                <span>Navigate</span>
            </div>
        </div>
    </div>

    <!-- ========================================================= -->
    <!-- 2. 3D SPATIAL MATRIX GRID VIEW (ALTERNATIVE VIEW) -->
    <!-- ========================================================= -->
    <div id="view-grid-container" class="hidden relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 transition-opacity duration-500">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
            {projects.map((project, index) => {
                const techList = project.data.tech_stack || [];
                const paddedIndex = String(index + 1).padStart(2, '0');
                return (
                    <div data-aos="fade-up" data-aos-delay={index * 80} class="h-full">
                        <article
                            class="group relative h-full rounded-[26px] p-5 flex flex-col justify-between overflow-hidden border border-slate-200/90 dark:border-white/15 bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl shadow-lg hover:shadow-2xl hover:shadow-cyan-500/10 transition-all duration-300 hover:-translate-y-2 transform-style-3d"
                            data-tilt
                            data-tilt-max="8"
                            data-tilt-speed="400"
                        >
                            <!-- Ambient Glow on Hover -->
                            <div class="absolute -top-24 -right-24 w-48 h-48 bg-cyan-500/10 rounded-full blur-3xl group-hover:bg-cyan-500/25 transition-colors duration-500 pointer-events-none"></div>

                            <div>
                                <!-- Top Bar -->
                                <div class="flex items-center justify-between mb-4 border-b border-slate-200 dark:border-white/10 pb-3">
                                    <span class="text-[10px] font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400 font-semibold">
                                        EXP #{paddedIndex}
                                    </span>
                                    <div class="flex gap-1.5">
                                        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                                        <span class="w-2 h-2 rounded-full bg-primary-400"></span>
                                    </div>
                                </div>

                                <!-- Image Screen -->
                                <div class="relative w-full aspect-video rounded-xl overflow-hidden border border-slate-200 dark:border-white/10 mb-4 bg-slate-900">
                                    {project.data.thumbnail ? (
                                        <img
                                            src={project.data.thumbnail}
                                            alt={project.data.title}
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                            loading="lazy"
                                        />
                                    ) : (
                                        <div class="w-full h-full flex items-center justify-center text-cyan-400 bg-slate-900 font-mono text-xs">
                                            🚀 SYSTEM DEPLOYED
                                        </div>
                                    )}
                                </div>

                                <!-- Tech stack -->
                                <div class="flex flex-wrap gap-1.5 mb-3">
                                    {techList.slice(0, 3).map((tech) => (
                                        <span class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-primary-700 dark:text-cyan-300 border border-slate-200 dark:border-white/10">
                                            {tech}
                                        </span>
                                    ))}
                                </div>

                                <h3 class="text-xl font-bold font-display text-slate-900 dark:text-white mb-2 group-hover:text-primary-600 dark:group-hover:text-cyan-400 transition-colors">
                                    {project.data.title}
                                </h3>
                                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 line-clamp-2 mb-4 leading-relaxed">
                                    {project.data.description}
                                </p>
                            </div>

                            <!-- Footer -->
                            <div class="pt-3 border-t border-slate-200 dark:border-white/10 flex items-center justify-between">
                                <a
                                    href={`/projects/${project.slug}`}
                                    class="inline-flex items-center gap-1.5 text-xs font-bold text-primary-600 dark:text-cyan-400 hover:gap-2.5 transition-all"
                                >
                                    <span>Explore Milestone</span>
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
