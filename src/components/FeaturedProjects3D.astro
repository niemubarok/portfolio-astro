<!-- ========================================================= -->
<!-- 3D CAROUSEL SCRIPT: PHYSICS, 3D PROJECTION & INTERACTION -->
<!-- ========================================================= -->
<script>
    class SpatialStageShowroom {
        container: HTMLElement | null = null;
        viewport: HTMLElement | null = null;
        stage: HTMLElement | null = null;
        cards: HTMLElement[] = [];
        bullets: HTMLElement[] = [];
        btnPrev: HTMLElement | null = null;
        btnNext: HTMLElement | null = null;
        btnModeDeck: HTMLElement | null = null;
        btnModeGrid: HTMLElement | null = null;
        viewDeck: HTMLElement | null = null;
        viewGrid: HTMLElement | null = null;
        indexDisplay: HTMLElement | null = null;
        titlePreview: HTMLElement | null = null;

        currentIndex = 0;
        totalCards = 0;
        isDragging = false;
        startX = 0;
        dragDelta = 0;

        // Stage Tilt Parallax Physics
        stageTilt = { x: 0, y: 0, targetX: 0, targetY: 0 };
        animFrameId: number | null = null;

        constructor() {
            this.container = document.getElementById('featured-3d-experience');
            if (!this.container) return;

            this.viewport = document.getElementById('room-viewport');
            this.stage = document.getElementById('room-stage');
            this.cards = Array.from(this.container.querySelectorAll('.spatial-card')) as HTMLElement[];
            this.bullets = Array.from(this.container.querySelectorAll('.stage-bullet')) as HTMLElement[];
            this.btnPrev = document.getElementById('btn-stage-prev');
            this.btnNext = document.getElementById('btn-stage-next');
            this.btnModeDeck = document.getElementById('btn-mode-deck');
            this.btnModeGrid = document.getElementById('btn-mode-grid');
            this.viewDeck = document.getElementById('view-deck-container');
            this.viewGrid = document.getElementById('view-grid-container');
            this.indexDisplay = document.getElementById('current-index-display');
            this.titlePreview = document.getElementById('active-title-preview');

            this.totalCards = this.cards.length;
            if (this.totalCards === 0) return;

            this.bindEvents();
            this.updateCarousel(0, false);
            this.startParallaxLoop();
        }

        bindEvents() {
            // Next / Prev buttons
            this.btnPrev?.addEventListener('click', (e) => {
                e.stopPropagation();
                this.navigate(-1);
            });
            this.btnNext?.addEventListener('click', (e) => {
                e.stopPropagation();
                this.navigate(1);
            });

            // Card direct click
            this.cards.forEach((card) => {
                card.addEventListener('click', (e) => {
                    const cardIndex = parseInt(card.getAttribute('data-index') || '0', 10);
                    if (cardIndex !== this.currentIndex) {
                        e.preventDefault();
                        e.stopPropagation();
                        this.goToSlide(cardIndex);
                    }
                });
            });

            // Bullets click
            this.bullets.forEach((bullet) => {
                bullet.addEventListener('click', () => {
                    const targetIdx = parseInt(bullet.getAttribute('data-target-index') || '0', 10);
                    this.goToSlide(targetIdx);
                });
            });

            // Drag & Swipe on Viewport
            if (this.viewport) {
                const onStart = (clientX: number) => {
                    this.isDragging = true;
                    this.startX = clientX;
                    this.dragDelta = 0;
                };

                const onMove = (clientX: number) => {
                    if (!this.isDragging) return;
                    this.dragDelta = clientX - this.startX;
                };

                const onEnd = () => {
                    if (!this.isDragging) return;
                    this.isDragging = false;
                    const threshold = 45;
                    if (this.dragDelta < -threshold) {
                        this.navigate(1);
                    } else if (this.dragDelta > threshold) {
                        this.navigate(-1);
                    }
                    this.dragDelta = 0;
                };

                // Mouse Drag
                this.viewport.addEventListener('mousedown', (e) => onStart(e.clientX));
                window.addEventListener('mousemove', (e) => onMove(e.clientX));
                window.addEventListener('mouseup', () => onEnd());

                // Touch Swipe
                this.viewport.addEventListener('touchstart', (e) => onStart(e.touches[0].clientX), { passive: true });
                this.viewport.addEventListener('touchmove', (e) => onMove(e.touches[0].clientX), { passive: true });
                this.viewport.addEventListener('touchend', () => onEnd());
                this.viewport.addEventListener('touchcancel', () => onEnd());

                // Mouse Parallax Stage Tilt
                this.viewport.addEventListener('mousemove', (e) => {
                    const rect = this.viewport!.getBoundingClientRect();
                    const centerX = rect.left + rect.width / 2;
                    const centerY = rect.top + rect.height / 2;
                    const normX = (e.clientX - centerX) / (rect.width / 2);
                    const normY = (e.clientY - centerY) / (rect.height / 2);

                    this.stageTilt.targetX = -normY * 6; // Max 6deg pitch
                    this.stageTilt.targetY = normX * 8;  // Max 8deg yaw

                    // Update active card glare
                    const activeCard = this.cards[this.currentIndex];
                    if (activeCard) {
                        const glare = activeCard.querySelector('.card-glare') as HTMLElement;
                        if (glare) {
                            glare.style.opacity = '0.35';
                            glare.style.background = `radial-gradient(circle at ${50 + normX * 30}% ${50 + normY * 30}%, rgba(255,255,255,0.4) 0%, transparent 60%)`;
                        }
                    }
                });

                this.viewport.addEventListener('mouseleave', () => {
                    this.stageTilt.targetX = 0;
                    this.stageTilt.targetY = 0;
                    this.cards.forEach((c) => {
                        const g = c.querySelector('.card-glare') as HTMLElement;
                        if (g) g.style.opacity = '0';
                    });
                });
            }

            // Keyboard navigation when hovering or in viewport
            window.addEventListener('keydown', (e) => {
                if (!this.container) return;
                const rect = this.container.getBoundingClientRect();
                const isInView = rect.top < window.innerHeight && rect.bottom > 0;
                if (!isInView) return;

                if (e.key === 'ArrowLeft') {
                    this.navigate(-1);
                } else if (e.key === 'ArrowRight') {
                    this.navigate(1);
                }
            });

            // View Mode Switcher
            this.btnModeDeck?.addEventListener('click', () => this.switchMode('deck'));
            this.btnModeGrid?.addEventListener('click', () => this.switchMode('grid'));

            // Responsive Re-layout on Window Resize
            window.addEventListener('resize', () => {
                this.updateCarousel(this.currentIndex, false);
            });
        }

        switchMode(mode: 'deck' | 'grid') {
            if (mode === 'deck') {
                this.btnModeDeck?.classList.add('active');
                this.btnModeDeck?.classList.remove('text-slate-600', 'dark:text-slate-400');
                this.btnModeGrid?.classList.remove('active');
                this.btnModeGrid?.classList.add('text-slate-600', 'dark:text-slate-400');

                this.viewDeck?.classList.remove('hidden');
                this.viewGrid?.classList.add('hidden');
                this.updateCarousel(this.currentIndex, false);
            } else {
                this.btnModeGrid?.classList.add('active');
                this.btnModeGrid?.classList.remove('text-slate-600', 'dark:text-slate-400');
                this.btnModeDeck?.classList.remove('active');
                this.btnModeDeck?.classList.add('text-slate-600', 'dark:text-slate-400');

                this.viewGrid?.classList.remove('hidden');
                this.viewDeck?.classList.add('hidden');
            }
        }

        navigate(direction: number) {
            let nextIndex = (this.currentIndex + direction) % this.totalCards;
            if (nextIndex < 0) nextIndex = this.totalCards - 1;
            this.goToSlide(nextIndex);
        }

        goToSlide(index: number) {
            this.currentIndex = index;
            this.updateCarousel(index, true);
        }

        updateCarousel(activeIndex: number, _smooth = true) {
            const isMobile = window.innerWidth < 640;
            const isTablet = window.innerWidth >= 640 && window.innerWidth < 1024;

            // Geometry settings for the 3D Arc
            const stepX = isMobile ? 180 : (isTablet ? 290 : 380);
            const stepZ = isMobile ? -140 : -160;
            const rotYStep = isMobile ? 32 : 30;

            this.cards.forEach((card, i) => {
                // Compute cyclic offset from active (-N ... 0 ... +N)
                let offset = i - activeIndex;
                if (offset > this.totalCards / 2) offset -= this.totalCards;
                if (offset < -this.totalCards / 2) offset += this.totalCards;

                const absOffset = Math.abs(offset);

                if (offset === 0) {
                    // Center Active Card (Dominant, Front, Layered Depth)
                    card.style.transform = `translate3d(0px, 0px, 80px) rotateY(0deg) scale(1)`;
                    card.style.opacity = '1';
                    card.style.zIndex = '35';
                    card.style.pointerEvents = 'auto';
                    card.style.filter = 'drop-shadow(0 30px 60px rgba(6,182,212,0.22))';
                    card.classList.add('is-active-center');
                } else if (absOffset === 1) {
                    // Immediate Left / Right Flanking Cards (Angled in 3D perspective)
                    const posX = offset * stepX;
                    const posZ = stepZ;
                    const rotY = offset > 0 ? -rotYStep : rotYStep;
                    const scale = isMobile ? 0.8 : 0.86;

                    card.style.transform = `translate3d(${posX}px, 0px, ${posZ}px) rotateY(${rotY}deg) scale(${scale})`;
                    card.style.opacity = isMobile ? '0.45' : '0.75';
                    card.style.zIndex = '20';
                    card.style.pointerEvents = 'auto';
                    card.style.filter = 'drop-shadow(0 15px 30px rgba(0,0,0,0.4)) brightness(0.9)';
                    card.classList.remove('is-active-center');
                } else if (absOffset === 2) {
                    // Far Outer Cards
                    const posX = offset * (stepX * 1.55);
                    const posZ = stepZ * 2.2;
                    const rotY = offset > 0 ? -rotYStep * 1.35 : rotYStep * 1.35;
                    const scale = isMobile ? 0.65 : 0.72;

                    card.style.transform = `translate3d(${posX}px, 0px, ${posZ}px) rotateY(${rotY}deg) scale(${scale})`;
                    card.style.opacity = isMobile ? '0' : '0.35';
                    card.style.zIndex = '10';
                    card.style.pointerEvents = isMobile ? 'none' : 'auto';
                    card.style.filter = 'drop-shadow(0 10px 20px rgba(0,0,0,0.5)) brightness(0.7)';
                    card.classList.remove('is-active-center');
                } else {
                    // Hidden depth-receded cards
                    card.style.transform = `translate3d(0px, 0px, -500px) scale(0.5)`;
                    card.style.opacity = '0';
                    card.style.zIndex = '0';
                    card.style.pointerEvents = 'none';
                    card.classList.remove('is-active-center');
                }
            });

            // Update Counter & Previews
            if (this.indexDisplay) {
                this.indexDisplay.textContent = String(activeIndex + 1).padStart(2, '0');
            }

            const activeCard = this.cards[activeIndex];
            if (this.titlePreview && activeCard) {
                const titleEl = activeCard.querySelector('h3');
                if (titleEl) {
                    this.titlePreview.textContent = titleEl.textContent?.trim() || '';
                }
            }

            // Update Bullets
            this.bullets.forEach((bullet, idx) => {
                if (idx === activeIndex) {
                    bullet.style.width = '2.2rem';
                    bullet.style.background = 'linear-gradient(90deg, #06b6d4, #8b5cf6)';
                    bullet.style.boxShadow = '0 0 12px rgba(6, 182, 212, 0.7)';
                } else {
                    bullet.style.width = '0.625rem';
                    bullet.style.background = 'rgba(148, 163, 184, 0.4)';
                    bullet.style.boxShadow = 'none';
                }
            });
        }

        startParallaxLoop() {
            const updateLoop = () => {
                // Smooth Lerp damping
                this.stageTilt.x += (this.stageTilt.targetX - this.stageTilt.x) * 0.1;
                this.stageTilt.y += (this.stageTilt.targetY - this.stageTilt.y) * 0.1;

                if (this.stage) {
                    this.stage.style.transform = `rotateX(${this.stageTilt.x.toFixed(2)}deg) rotateY(${this.stageTilt.y.toFixed(2)}deg)`;
                }

                this.animFrameId = requestAnimationFrame(updateLoop);
            };

            this.animFrameId = requestAnimationFrame(updateLoop);
        }

        destroy() {
            if (this.animFrameId !== null) {
                cancelAnimationFrame(this.animFrameId);
                this.animFrameId = null;
            }
        }
    }

    // Lifecycle
    function initSpatialStage() {
        if ((window as any).__spatialStageInstance) {
            (window as any).__spatialStageInstance.destroy();
        }
        (window as any).__spatialStageInstance = new SpatialStageShowroom();
    }

    document.addEventListener('astro:page-load', initSpatialStage);
    document.addEventListener('DOMContentLoaded', initSpatialStage);
</script>
