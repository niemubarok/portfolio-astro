---
// Footer.astro
import siteData from '../data/site.json';

const currentYear = new Date().getFullYear();

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Featured Projects', href: '/#projects' },
  { label: 'Arsenal & Skills', href: '/#skills' },
  { label: 'Career Journey', href: '/#career' },
  { label: 'Contact', href: '/#contact' },
  { label: 'All Projects Archive', href: '/projects' },
];

const capabilities = [
  { name: 'AI & LLM Workflows', icon: '⚡' },
  { name: 'Full-Stack Web Apps', icon: '🌐' },
  { name: 'Vue / React / Next.js', icon: '⚛️' },
  { name: 'Laravel & Node.js', icon: '🚀' },
  { name: 'Astro & High-Perf UIs', icon: '✨' },
  { name: 'Cloud, Docker & DevOps', icon: '☁️' },
];

const socialLinks = [
  {
    name: 'GitHub',
    url: siteData.social.github,
    handle: '@niemubarok',
    icon: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>`,
    color: 'hover:text-violet-500 hover:border-violet-500/40 hover:bg-violet-500/10'
  },
  {
    name: 'LinkedIn',
    url: siteData.social.linkedin,
    handle: 'in/niemubarok',
    icon: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.62 1.62 0 0 0-1.63 1.62 1.62 1.62 0 0 0 1.63 1.63 1.62 1.62 0 0 0 1.63-1.63 1.62 1.62 0 0 0-1.63-1.62z"/></svg>`,
    color: 'hover:text-blue-500 hover:border-blue-500/40 hover:bg-blue-500/10'
  },
  {
    name: 'WhatsApp',
    url: `https://wa.me/${siteData.contact.phone.replace(/\\D/g, '')}`,
    handle: siteData.contact.phone,
    icon: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.75-.67-1.25-1.49-1.4-1.74-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.77 2.71 4.3 3.8 2.53 1.09 2.53.73 2.99.68.46-.04 1.47-.6 1.68-1.18.21-.59.21-1.09.15-1.19-.06-.1-.22-.16-.47-.29z"/></svg>`,
    color: 'hover:text-emerald-500 hover:border-emerald-500/40 hover:bg-emerald-500/10'
  }
];
---

<footer class="relative mt-20 sm:mt-28 overflow-hidden bg-slate-100/70 dark:bg-[#070b14] border-t border-slate-200/80 dark:border-white/[0.08] transition-colors duration-300">
  {/* Ambient Gradient Glows */}
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-primary-500/50 dark:via-cyan-400/40 to-transparent"></div>
  <div class="absolute -top-32 left-1/4 w-96 h-96 bg-primary-500/10 dark:bg-primary-600/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute -bottom-32 right-1/4 w-96 h-96 bg-cyan-500/10 dark:bg-purple-600/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    
    {/* Top Header Card: Status & Quick Pitch */}
    <div class="mb-14 p-6 sm:p-8 rounded-3xl bg-white/70 dark:bg-white/[0.03] border border-slate-200/80 dark:border-white/10 backdrop-blur-xl shadow-xl shadow-slate-200/40 dark:shadow-none flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2">
        <div class="flex items-center gap-3">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
          <span class="text-xs font-mono font-semibold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">
            Available for New Projects & Collaborations
          </span>
        </div>
        <h3 class="text-xl sm:text-2xl font-bold font-display text-slate-900 dark:text-white">
          Let's turn your next vision into high-impact software.
        </h3>
      </div>
      <div class="flex items-center gap-3 w-full md:w-auto">
        <a
          href={`mailto:${siteData.contact.email}`}
          class="flex-1 md:flex-initial inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-primary-600 to-purple-600 text-white font-semibold text-sm shadow-md hover:shadow-primary-500/25 hover:scale-105 transition-all duration-300"
        >
          <span>Start a Project</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
        <button
          id="footer-back-to-top"
          type="button"
          class="inline-flex items-center justify-center w-11 h-11 rounded-full border border-slate-200 dark:border-white/10 bg-white/80 dark:bg-white/5 text-slate-600 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-400 hover:border-primary-400 dark:hover:border-primary-500/50 hover:scale-105 transition-all duration-300 shadow-sm cursor-pointer"
          title="Back to Top"
          aria-label="Scroll back to top"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
          </svg>
        </button>
      </div>
    </div>

    {/* Main Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 mb-14">
      
      {/* Brand & Persona Section */}
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="group inline-flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary-500 to-purple-600 flex items-center justify-center shadow-md shadow-primary-500/20 group-hover:rotate-6 transition-transform duration-300">
            <span class="font-display font-black text-white text-xl">M</span>
          </div>
          <div>
            <span class="block font-display font-bold text-lg text-slate-900 dark:text-white tracking-tight leading-none group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
              {siteData.profile.name}
            </span>
            <span class="block text-xs font-mono text-slate-500 dark:text-slate-400 mt-1">
              {siteData.profile.title}
            </span>
          </div>
        </a>

        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-sm">
          {siteData.profile.bio}
        </p>

        <div class="pt-2 flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400">
          <svg class="w-4 h-4 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>{siteData.contact.address}</span>
        </div>
      </div>

      {/* Navigation Links */}
      <div class="lg:col-span-2 space-y-4">
        <h4 class="text-xs font-mono font-bold uppercase tracking-widest text-slate-900 dark:text-white">
          Navigation
        </h4>
        <ul class="space-y-2.5">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="group inline-flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-200"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-700 group-hover:bg-primary-500 dark:group-hover:bg-primary-400 transition-colors"></span>
                <span>{link.label}</span>
                <span class="opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 text-xs text-primary-500">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Arsenal & Capabilities */}
      <div class="lg:col-span-3 space-y-4">
        <h4 class="text-xs font-mono font-bold uppercase tracking-widest text-slate-900 dark:text-white">
          Arsenal & Domain
        </h4>
        <div class="flex flex-wrap gap-2">
          {capabilities.map((cap) => (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium bg-white/80 dark:bg-white/[0.04] border border-slate-200/90 dark:border-white/10 text-slate-700 dark:text-slate-300 shadow-xs hover:border-primary-400 dark:hover:border-primary-500/50 hover:text-primary-600 dark:hover:text-primary-300 transition-all duration-200 cursor-default">
              <span class="text-xs">{cap.icon}</span>
              <span>{cap.name}</span>
            </span>
          ))}
        </div>
      </div>

      {/* Direct Connect & Socials */}
      <div class="lg:col-span-3 space-y-4">
        <h4 class="text-xs font-mono font-bold uppercase tracking-widest text-slate-900 dark:text-white">
          Connect Directly
        </h4>
        <div class="space-y-2.5">
          {socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`group flex items-center justify-between p-2.5 rounded-2xl bg-white/60 dark:bg-white/[0.02] border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 transition-all duration-300 shadow-xs ${social.color}`}
            >
              <div class="flex items-center gap-3">
                <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-slate-100 dark:bg-white/5 group-hover:scale-110 transition-transform duration-300" set:html={social.icon}></span>
                <div>
                  <span class="block text-xs font-bold leading-tight">{social.name}</span>
                  <span class="block text-[11px] font-mono text-slate-500 dark:text-slate-400">{social.handle}</span>
                </div>
              </div>
              <span class="text-xs text-slate-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-200">↗</span>
            </a>
          ))}
        </div>
      </div>

    </div>

    {/* Bottom Divider */}
    <div class="h-px bg-gradient-to-r from-transparent via-slate-200 dark:via-white/10 to-transparent mb-8"></div>

    {/* Copyright & Architecture Watermark */}
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400 font-mono">
      <div class="flex items-center gap-2 text-center sm:text-left">
        <span>© {currentYear} {siteData.profile.name}.</span>
        <span class="hidden sm:inline text-slate-300 dark:text-slate-700">•</span>
        <span class="hidden sm:inline">Crafted with precision & AI-augmented speed.</span>
      </div>

      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-200/60 dark:bg-white/5 text-[11px] font-medium text-slate-600 dark:text-slate-400">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
          Astro 4.x + Tailwind
        </span>
        <button
          type="button"
          id="footer-back-to-top-text"
          class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors flex items-center gap-1 cursor-pointer bg-transparent border-0 p-0 text-xs font-mono text-slate-500 dark:text-slate-400"
        >
          <span>Top</span>
          <span>↑</span>
        </button>
      </div>
    </div>

  </div>
</footer>

<script>
  function setupFooterScroll() {
    const topButtons = [
      document.getElementById('footer-back-to-top'),
      document.getElementById('footer-back-to-top-text')
    ];

    topButtons.forEach((btn) => {
      if (!btn) return;
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    });
  }

  document.addEventListener('astro:page-load', setupFooterScroll);
  setupFooterScroll();
</script>

