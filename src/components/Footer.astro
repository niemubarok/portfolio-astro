---
const currentYear = new Date().getFullYear();
import siteData from '../data/site.json';

const footerLinks = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects' },
  { label: 'Contact', href: '#contact' },
];

const expertise = ['Laravel', 'Vue.js', 'React', 'Full-Stack'];
---

<footer class="relative mt-24 overflow-hidden">
  {/* Background Elements */}
  <div class="absolute inset-0 bg-gradient-to-b from-dark-bg via-dark-surface to-dark-bg opacity-80"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(99,102,241,0.05),transparent_50%)]"></div>
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-primary-500/20 to-transparent"></div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    {/* Main Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      {/* Brand Section */}
      <div class="lg:col-span-1">
        <div class="mb-4">
          <h2 class="text-2xl font-bold font-display text-white mb-1 bg-gradient-to-r from-white via-slate-100 to-slate-300 bg-clip-text text-transparent">
            {siteData.site_name.split(' ')[0]}
          </h2>
          <div class="h-1 w-12 bg-gradient-to-r from-primary-500 to-primary-400 rounded-full"></div>
        </div>
        <p class="text-slate-400 text-sm leading-relaxed">
          {siteData.profile.bio}
        </p>
      </div>

      {/* Navigation Links */}
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-widest mb-4">Navigation</h3>
        <ul class="space-y-2">
          {footerLinks.map((link) => (
            <li>
              <a 
                href={link.href}
                class="text-slate-400 hover:text-primary-400 transition-colors duration-300 text-sm group inline-flex items-center"
              >
                {link.label}
                <span class="inline-block ml-0 group-hover:ml-2 opacity-0 group-hover:opacity-100 transition-all duration-300 w-4">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Expertise */}
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-widest mb-4">Expertise</h3>
        <div class="flex flex-wrap gap-2">
          {expertise.map((skill) => (
            <span class="px-3 py-1 text-xs bg-primary-500/10 border border-primary-500/30 text-primary-300 rounded-full hover:border-primary-500/60 hover:bg-primary-500/20 transition-all duration-300 cursor-default">
              {skill}
            </span>
          ))}
        </div>
      </div>

      {/* Contact & Social */}
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-widest mb-4">Connect</h3>
        <div class="space-y-4">
          <div>
            <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Email</p>
            <a 
              href={`mailto:${siteData.contact.email}`}
              class="text-slate-300 hover:text-primary-400 transition-colors duration-300 text-sm break-all"
            >
              {siteData.contact.email}
            </a>
          </div>
          <div>
            <p class="text-xs text-slate-500 uppercase tracking-wider mb-2">Social</p>
            <div class="flex gap-3">
              {siteData.social.github && (
                <a 
                  href={siteData.social.github} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="w-9 h-9 rounded-lg bg-slate-800/50 hover:bg-primary-500/20 border border-slate-700 hover:border-primary-500/50 flex items-center justify-center text-slate-400 hover:text-primary-400 transition-all duration-300 group"
                  aria-label="GitHub"
                >
                  <i class="devicon-github-plain text-lg group-hover:scale-110 transition-transform duration-300"></i>
                </a>
              )}
              {siteData.social.linkedin && (
                <a 
                  href={siteData.social.linkedin} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="w-9 h-9 rounded-lg bg-slate-800/50 hover:bg-primary-500/20 border border-slate-700 hover:border-primary-500/50 flex items-center justify-center text-slate-400 hover:text-primary-400 transition-all duration-300 group"
                  aria-label="LinkedIn"
                >
                  <i class="devicon-linkedin-plain text-lg group-hover:scale-110 transition-transform duration-300"></i>
                </a>
              )}
              {siteData.social.twitter && (
                <a 
                  href={siteData.social.twitter} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="w-9 h-9 rounded-lg bg-slate-800/50 hover:bg-primary-500/20 border border-slate-700 hover:border-primary-500/50 flex items-center justify-center text-slate-400 hover:text-primary-400 transition-all duration-300 group"
                  aria-label="Twitter"
                >
                  <i class="devicon-twitter-original text-lg group-hover:scale-110 transition-transform duration-300"></i>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Divider */}
    <div class="h-px bg-gradient-to-r from-transparent via-slate-700/50 to-transparent mb-8"></div>

    {/* Bottom Section */}
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-slate-500 text-xs">
        © {currentYear} {siteData.profile.name}. All rights reserved.
      </p>
      <div class="flex gap-6 text-xs">
        <a href="#privacy" class="text-slate-500 hover:text-slate-300 transition-colors duration-300">
          Privacy Policy
        </a>
        <a href="#terms" class="text-slate-500 hover:text-slate-300 transition-colors duration-300">
          Terms of Service
        </a>
      </div>
    </div>
  </div>

  {/* Subtle animated gradient accent */}
  <style>
    footer {
      position: relative;
    }
  </style>
</footer>
