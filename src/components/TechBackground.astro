---
// TechBackground.astro
export interface Props {
    theme?: 'code' | 'grid' | 'binary' | 'circuit';
    direction?: 'up' | 'down' | 'left' | 'right';
    speed?: number;
}

const { theme = 'code', direction = 'up', speed = 0.3 } = Astro.props;

// Clean Modern Syntax Watermarks
const codeLines = [
    '<span class="text-indigo-600 dark:text-indigo-400">import</span> { <span class="text-cyan-700 dark:text-cyan-300">LLMOrchestrator</span>, <span class="text-cyan-700 dark:text-cyan-300">AgentPipeline</span> } <span class="text-indigo-600 dark:text-indigo-400">from</span> <span class="text-amber-700 dark:text-amber-300">"@ai/runtime"</span>;',
    '<span class="text-indigo-600 dark:text-indigo-400">const</span> <span class="text-cyan-700 dark:text-cyan-300">pipeline</span> = <span class="text-indigo-600 dark:text-indigo-400">new</span> <span class="text-amber-700 dark:text-amber-300">AgentPipeline</span>({ <span class="text-slate-600 dark:text-slate-400">model:</span> <span class="text-emerald-700 dark:text-emerald-400">"neural-engine"</span>, <span class="text-slate-600 dark:text-slate-400">stream:</span> <span class="text-emerald-700 dark:text-emerald-400">true</span> });',
    '<span class="text-purple-700 dark:text-purple-400">export async function</span> <span class="text-cyan-700 dark:text-cyan-300">executeAgenticWorkflow</span>(<span class="text-slate-600 dark:text-slate-400">prompt</span>: <span class="text-amber-700 dark:text-amber-300">UserPrompt</span>) {',
    '  <span class="text-indigo-600 dark:text-indigo-400">const</span> <span class="text-slate-600 dark:text-slate-400">embeddings</span> = <span class="text-indigo-600 dark:text-indigo-400">await</span> <span class="text-cyan-700 dark:text-cyan-300">vectorDB</span>.<span class="text-amber-700 dark:text-amber-300">similaritySearch</span>(<span class="text-slate-600 dark:text-slate-400">prompt</span>, { <span class="text-slate-600 dark:text-slate-400">topK:</span> <span class="text-amber-700 dark:text-amber-300">8</span> });',
    '  <span class="text-indigo-600 dark:text-indigo-400">return await</span> <span class="text-cyan-700 dark:text-cyan-300">pipeline</span>.<span class="text-amber-700 dark:text-amber-300">streamResponse</span>({ <span class="text-slate-600 dark:text-slate-400">context:</span> <span class="text-slate-600 dark:text-slate-400">embeddings</span>, <span class="text-slate-600 dark:text-slate-400">temperature:</span> <span class="text-amber-700 dark:text-amber-300">0.2</span> });',
    '}',
    '<span class="text-slate-500">// Distributed Architecture & Cloud Edge Pipeline</span>',
    '<span class="text-purple-700 dark:text-purple-400">type</span> <span class="text-amber-700 dark:text-amber-300">ReactiveStream</span>&lt;<span class="text-cyan-700 dark:text-cyan-300">T</span>&gt; = <span class="text-amber-700 dark:text-amber-300">AsyncGenerator</span>&lt;<span class="text-cyan-700 dark:text-cyan-300">T</span>, <span class="text-pink-600 dark:text-pink-400">void</span>, <span class="text-pink-600 dark:text-pink-400">unknown</span>&gt;;',
    '<span class="text-indigo-600 dark:text-indigo-400">const</span> [<span class="text-cyan-700 dark:text-cyan-300">cluster</span>, <span class="text-cyan-700 dark:text-cyan-300">mutate</span>] = <span class="text-amber-700 dark:text-amber-300">useProductionCluster</span>(<span class="text-slate-600 dark:text-slate-400">"global-edge-ap-southeast"</span>);',
    '<span class="text-indigo-600 dark:text-indigo-400">await</span> <span class="text-cyan-700 dark:text-cyan-300">k8sCluster</span>.<span class="text-amber-700 dark:text-amber-300">autoScaleNodes</span>({ <span class="text-slate-600 dark:text-slate-400">min:</span> <span class="text-amber-700 dark:text-amber-300">4</span>, <span class="text-slate-600 dark:text-slate-400">max:</span> <span class="text-amber-700 dark:text-amber-300">64</span>, <span class="text-slate-600 dark:text-slate-400">targetCPU:</span> <span class="text-amber-700 dark:text-amber-300">0.75</span> });',
];

const binaryStreams = [
    '0x8FCA91E // SYS_OK',
    '01101001 01101110',
    'STREAM_READY [200]',
    '0x4A7B // LATENCY_12ms',
    '11010010 10110001',
    'AUTONOMOUS_RUN // IDLE',
    '0x9C33 // VEC_DIM_1536',
    '00101101 11001011',
];
---

<div class="absolute inset-0 overflow-hidden pointer-events-none select-none z-0">
    <!-- Parallax Layer -->
    <div
        class="parallax-layer w-full h-full absolute inset-0 flex flex-col justify-center"
        data-speed={speed}
        data-direction={direction}
    >
        {
            theme === 'code' && (
                <div class="w-full max-w-7xl mx-auto px-4 sm:px-8 flex justify-start">
                    <div class="w-full lg:w-[65%] xl:w-[60%] opacity-[0.08] dark:opacity-[0.05] font-mono text-xs sm:text-sm md:text-base leading-relaxed sm:leading-loose space-y-3 sm:space-y-4 pointer-events-none transform -rotate-[3deg] -translate-x-6 sm:-translate-x-12 md:-translate-x-16 lg:-translate-x-24 xl:-translate-x-32 blur-[1.5px] sm:blur-[2px] select-none">
                        {codeLines.map((line, i) => (
                            <div
                                class="whitespace-nowrap transition-opacity duration-300 drop-shadow-sm"
                                style={`padding-left: ${(i % 4) * 2.5}rem`}
                            >
                                <Fragment set:html={line} />
                            </div>
                        ))}
                    </div>
                </div>
            )
        }

        {
            theme === 'grid' && (
                <div class="w-full h-full relative">
                    <!-- Precision Dot-Matrix Grid -->
                    <div
                        class="absolute inset-0 opacity-[0.08] dark:opacity-[0.05]"
                        style="background-image: radial-gradient(rgba(99, 102, 241, 0.9) 1px, transparent 1px); background-size: 32px 32px; mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%); -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);"
                    />
                    <!-- Subtle Architectural Line Grid Overlay -->
                    <div
                        class="absolute inset-0 opacity-[0.04] dark:opacity-[0.025]"
                        style="background-image: linear-gradient(rgba(99, 102, 241, 0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(99, 102, 241, 0.4) 1px, transparent 1px); background-size: 96px 96px; mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);"
                    />
                </div>
            )
        }

        {
            theme === 'binary' && (
                <div class="w-full h-full flex items-center justify-around opacity-[0.08] dark:opacity-[0.05] font-mono text-xs text-cyan-600 dark:text-cyan-400 px-4 font-semibold dark:font-normal">
                    {Array.from({ length: 6 }).map((_, colIdx) => (
                        <div class="flex flex-col gap-3">
                            {binaryStreams.map((bin, i) => (
                                <span
                                    class="animate-pulse whitespace-nowrap"
                                    style={`animation-duration: ${3 + (colIdx % 3)}s; animation-delay: ${(i * 0.3) % 2}s`}
                                >
                                    {bin}
                                </span>
                            ))}
                        </div>
                    ))}
                </div>
            )
        }

        {
            theme === 'circuit' && (
                <div class="w-full h-full relative opacity-[0.08] dark:opacity-[0.05]">
                    <svg
                        class="w-full h-full"
                        viewBox="0 0 1200 400"
                        preserveAspectRatio="none"
                        fill="none"
                    >
                        <defs>
                            <linearGradient id="laser-line-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="#818cf8" stop-opacity="0" />
                                <stop offset="50%" stop-color="#06b6d4" stop-opacity="0.8" />
                                <stop offset="100%" stop-color="#c084fc" stop-opacity="0" />
                            </linearGradient>
                        </defs>
                        <!-- Circuit Traces -->
                        <path d="M 0,80 L 300,80 L 420,180 L 800,180 L 920,80 L 1200,80" stroke="url(#laser-line-grad)" stroke-width="1.2" />
                        <path d="M 0,220 L 240,220 L 360,120 L 750,120 L 880,240 L 1200,240" stroke="url(#laser-line-grad)" stroke-width="1" />
                        <path d="M 0,320 L 450,320 L 550,260 L 950,260 L 1050,320 L 1200,320" stroke="url(#laser-line-grad)" stroke-width="1" />
                        <!-- Circuit Node Pads -->
                        <circle cx="300" cy="80" r="3" fill="#06b6d4" />
                        <circle cx="420" cy="180" r="3" fill="#818cf8" />
                        <circle cx="800" cy="180" r="3" fill="#c084fc" />
                        <circle cx="360" cy="120" r="3" fill="#06b6d4" />
                        <circle cx="750" cy="120" r="3" fill="#818cf8" />
                    </svg>
                </div>
            )
        }
    </div>
</div>

<script>
    // Smooth scroll parallax
    const layers = document.querySelectorAll('.parallax-layer');

    window.addEventListener('scroll', () => {
        const scrolled = window.scrollY;

        layers.forEach((layer) => {
            const speed = parseFloat(layer.getAttribute('data-speed') || '0.2');
            const direction = layer.getAttribute('data-direction') || 'up';
            const element = layer as HTMLElement;

            const rect = element.parentElement?.getBoundingClientRect();
            if (rect && rect.top < window.innerHeight && rect.bottom > 0) {
                const offset = scrolled * speed;
                if (direction === 'up') element.style.transform = `translateY(-${offset * 0.5}px)`;
                if (direction === 'down') element.style.transform = `translateY(${offset * 0.5}px)`;
            }
        });
    }, { passive: true });
</script>

