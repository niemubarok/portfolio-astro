---
import skills from '../data/skills.json';

const desiredOrbitingSkills = [
    'TypeScript',
    'Next.js',
    'Astro',
    'Go',
    'React',
    'Tailwind CSS',
    'Docker',
    'Vue.js'
];

const orbitingSkills = skills.filter((skill) =>
    desiredOrbitingSkills.includes(skill.name)
);
---

<div class="relative w-full max-w-[540px] aspect-square flex items-center justify-center pointer-events-none select-none">
    <!-- Radiant Cyber Ambient Core -->
    <div
        class="absolute w-64 h-64 bg-gradient-to-tr from-primary-600/20 via-cyan-500/20 to-purple-600/20 rounded-full blur-3xl animate-pulse"
        style="animation-duration: 4s;"
    >
    </div>

    <!-- Technical Aperture SVG (Radar / Geometric HUD Rings) -->
    <svg class="absolute w-full h-full opacity-40 animate-[spin_60s_linear_infinite] will-change-transform" viewBox="0 0 500 500">
        <defs>
            <linearGradient id="hud-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#818cf8" stop-opacity="0.8" />
                <stop offset="50%" stop-color="#06b6d4" stop-opacity="0.9" />
                <stop offset="100%" stop-color="#c084fc" stop-opacity="0.8" />
            </linearGradient>
        </defs>

        <!-- Outer Dashed Ring -->
        <circle cx="250" cy="250" r="230" fill="none" stroke="url(#hud-grad)" stroke-width="1" stroke-dasharray="4 8" opacity="0.6" />
        <!-- Middle Precision Ring with Ticks -->
        <circle cx="250" cy="250" r="170" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1" stroke-dasharray="1 12" />
        <!-- Inner Ring -->
        <circle cx="250" cy="250" r="110" fill="none" stroke="url(#hud-grad)" stroke-width="1" stroke-dasharray="16 32" opacity="0.5" />
        
        <!-- Crosshairs -->
        <line x1="250" y1="10" x2="250" y2="30" stroke="#06b6d4" stroke-width="1.5" />
        <line x1="250" y1="470" x2="250" y2="490" stroke="#06b6d4" stroke-width="1.5" />
        <line x1="10" y1="250" x2="30" y2="250" stroke="#06b6d4" stroke-width="1.5" />
        <line x1="470" y1="250" x2="490" y2="250" stroke="#06b6d4" stroke-width="1.5" />
    </svg>

    <!-- Counter-rotating Inner Precision Dial -->
    <svg class="absolute w-[75%] h-[75%] opacity-25 animate-[spin_45s_linear_infinite_reverse] will-change-transform" viewBox="0 0 400 400">
        <circle cx="200" cy="200" r="190" fill="none" stroke="#818cf8" stroke-width="1" stroke-dasharray="2 18" />
        <circle cx="200" cy="200" r="130" fill="none" stroke="#06b6d4" stroke-width="1" stroke-dasharray="40 10 10 10" />
    </svg>

    <!-- Orbiting Frosted Glass Tech Badges -->
    {
        orbitingSkills.map((skill, index) => {
            const angle = (index / orbitingSkills.length) * 2 * Math.PI;
            const radius = 175;
            const x = Math.cos(angle) * radius;
            const y = Math.sin(angle) * radius;

            return (
                <div
                    class="absolute z-10 pointer-events-none md:pointer-events-auto will-change-transform"
                    style={`transform: translate3d(${x}px, ${y}px, 0);`}
                >
                    <div
                        class="group relative w-12 h-12 sm:w-13 sm:h-13 rounded-2xl bg-white/85 border border-slate-200/90 hover:border-cyan-500/60 backdrop-blur-md shadow-md hover:shadow-[0_0_20px_rgba(6,182,212,0.35)] dark:bg-slate-900/60 dark:border-white/15 dark:hover:border-cyan-400/50 dark:shadow-[0_8px_20px_rgba(0,0,0,0.6)] dark:hover:shadow-[0_0_20px_rgba(6,182,212,0.4)] flex items-center justify-center transition-all duration-300 hover:scale-115 cursor-pointer"
                        style={`animation: floatBadge 6s ease-in-out infinite; animation-delay: ${index * 0.45}s;`}
                        title={skill.name}
                    >
                        <!-- Hover Glow Layer -->
                        <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-cyan-500/20 via-primary-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

                        <!-- Tech Icon -->
                        <i class={`${skill.icon} text-2xl text-slate-700 group-hover:text-cyan-600 dark:text-slate-300 dark:group-hover:text-cyan-300 transition-colors duration-300 relative z-10 drop-shadow-sm`} />
                    </div>
                </div>
            );
        })
    }
</div>

<style>
    @keyframes floatBadge {
        0%,
        100% {
            transform: translate3d(0, 0px, 0) rotate(0deg);
        }
        50% {
            transform: translate3d(0, -8px, 0) rotate(2deg);
        }
    }
</style>

