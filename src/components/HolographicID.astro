---
import siteData from '../data/site.json';
---

<!-- Lanyard Top Anchor Point -->
<div
    id="card-anchor"
    class="absolute -top-20 sm:-top-28 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center pointer-events-none"
>
    <!-- Steel Ceiling Ring / Anchor Mount -->
    <div
        class="relative w-8 h-8 rounded-full bg-gradient-to-b from-slate-700 via-slate-800 to-slate-950 border border-white/30 shadow-[0_4px_12px_rgba(0,0,0,0.8),0_0_15px_rgba(139,92,246,0.3)] flex items-center justify-center"
    >
        <div class="w-4 h-4 rounded-full bg-gradient-to-b from-slate-900 to-slate-800 border border-white/20 shadow-inner flex items-center justify-center">
            <div class="w-1.5 h-1.5 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(6,182,212,0.9)] animate-pulse"></div>
        </div>
        <!-- Metallic Ring Highlight -->
        <div class="absolute inset-0 rounded-full border-t border-white/40 pointer-events-none"></div>
    </div>
</div>

<!-- Dynamic Realistic Lanyard Strap SVG -->
<svg
    class="fixed inset-0 w-full h-full pointer-events-none z-20 overflow-visible"
    id="lanyard-svg"
>
    <defs>
        <!-- Strap Fabric Gradient (Deep woven strap with neon edge threads) -->
        <linearGradient id="strap-fabric-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#1e1b4b" stop-opacity="0.95" />
            <stop offset="30%" stop-color="#312e81" stop-opacity="0.95" />
            <stop offset="70%" stop-color="#1e1b4b" stop-opacity="0.95" />
            <stop offset="100%" stop-color="#0f172a" stop-opacity="0.95" />
        </linearGradient>

        <!-- Lanyard Accent Glow Gradient -->
        <linearGradient id="strap-accent-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.9" />
            <stop offset="50%" stop-color="#06b6d4" stop-opacity="1" />
            <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.9" />
        </linearGradient>

        <!-- Shadow filter -->
        <filter id="strap-shadow" x="-30%" y="-30%" width="160%" height="160%">
            <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#000000" flood-opacity="0.6" />
        </filter>

        <!-- Glow filter -->
        <filter id="lanyard-soft-glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="4" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
    </defs>

    <!-- 1. Strap Drop Shadow -->
    <path
        id="lanyard-shadow-path"
        d=""
        fill="none"
        stroke="rgba(0, 0, 0, 0.5)"
        stroke-width="18"
        stroke-linecap="round"
        filter="url(#strap-shadow)"
    />

    <!-- 2. Ambient Neon Rim Glow -->
    <path
        id="lanyard-glow-path"
        d=""
        fill="none"
        stroke="url(#strap-accent-grad)"
        stroke-width="17"
        stroke-linecap="round"
        filter="url(#lanyard-soft-glow)"
        opacity="0.4"
    />

    <!-- 3. Main Woven Strap Body (14px wide textured ribbon) -->
    <path
        id="lanyard-main-path"
        d=""
        fill="none"
        stroke="url(#strap-fabric-grad)"
        stroke-width="14"
        stroke-linecap="round"
    />

    <!-- 4. Left/Right Colored Woven Edge Piping -->
    <path
        id="lanyard-edge-path"
        d=""
        fill="none"
        stroke="url(#strap-accent-grad)"
        stroke-width="14"
        stroke-dasharray="1 13"
        stroke-linecap="butt"
        opacity="0.85"
    />

    <!-- 5. Center High-Tech Security Stitching -->
    <path
        id="lanyard-stitch-path"
        d=""
        fill="none"
        stroke="rgba(255, 255, 255, 0.85)"
        stroke-width="1.8"
        stroke-dasharray="5 4"
        stroke-linecap="round"
    />
</svg>

<!-- Interactive Physics ID Card Container -->
<div
    id="id-card-wrapper"
    class="relative group w-full max-w-[340px] sm:max-w-[360px] h-auto cursor-grab active:cursor-grabbing mt-2 sm:mt-8 mx-auto select-none touch-pan-y"
    style="perspective: 1200px;"
>
    <!-- The 3D Physics Card Assembly -->
    <div
        id="physics-card"
        class="relative w-full h-full transform-style-3d will-change-transform transition-shadow duration-300"
    >
        <!-- Realistic 3D Cast Floor/Environment Shadow -->
        <div
            id="card-drop-shadow"
            class="absolute -inset-6 bg-black/60 rounded-[2.5rem] blur-2xl -z-20 transition-all duration-300 pointer-events-none"
        >
        </div>

        <!-- Ambient Cyber Glow -->
        <div
            class="absolute -inset-3 bg-gradient-to-br from-primary-600/20 via-cyan-500/15 to-purple-600/20 rounded-[2.2rem] blur-xl opacity-50 group-hover:opacity-80 transition duration-700 -z-10 pointer-events-none"
        >
        </div>

        <!-- ========================================== -->
        <!-- REALISTIC HARDWARE: METAL CARABINER / CLASP -->
        <!-- ========================================== -->
        <div
            id="card-hardware"
            class="absolute -top-12 left-1/2 -translate-x-1/2 z-30 flex flex-col items-center pointer-events-none transform-style-3d translate-z-20"
        >
            <!-- Lanyard Fabric Fold / Rivet Clasp -->
            <div class="w-8 h-4.5 bg-gradient-to-r from-slate-800 via-slate-700 to-slate-800 rounded-t-sm border-t border-x border-white/30 shadow-md flex items-center justify-center">
                <!-- Metal Rivet Dot -->
                <div class="w-2 h-2 rounded-full bg-gradient-to-b from-slate-400 to-slate-800 border border-white/40 shadow-inner"></div>
            </div>

            <!-- Swivel Barrel (Brushed Gunmetal Alloy) -->
            <div class="w-4 h-3.5 bg-gradient-to-r from-slate-600 via-slate-400 to-slate-700 border-x border-slate-900/60 shadow-sm flex items-center justify-center">
                <div class="w-full h-0.5 bg-slate-950/70"></div>
            </div>

            <!-- Spring Hook / Carabiner Loop (Loops directly into the acrylic punch hole) -->
            <div class="relative w-7 h-8 flex items-center justify-center">
                <svg viewBox="0 0 28 32" class="w-7 h-8 drop-shadow-[0_4px_6px_rgba(0,0,0,0.7)]">
                    <defs>
                        <linearGradient id="metal-hook-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#94a3b8" />
                            <stop offset="30%" stop-color="#f8fafc" />
                            <stop offset="60%" stop-color="#475569" />
                            <stop offset="100%" stop-color="#1e293b" />
                        </linearGradient>
                    </defs>
                    <!-- Hook Body -->
                    <path
                        d="M 14,0 C 7,0 4,5 4,12 C 4,22 8,28 14,28 C 20,28 24,22 24,12 C 24,6 21,0 14,0 Z"
                        fill="none"
                        stroke="url(#metal-hook-grad)"
                        stroke-width="3"
                        stroke-linecap="round"
                    />
                    <!-- Spring Catch Bar -->
                    <line x1="7" y1="11" x2="21" y2="13" stroke="#cbd5e1" stroke-width="2.2" stroke-linecap="round" />
                    <!-- Screw Lock Ring -->
                    <rect x="9.5" y="10" width="9" height="5" rx="1.5" fill="#334155" stroke="#94a3b8" stroke-width="0.8" />
                </svg>

                <!-- Lanyard Attachment Calculation Anchor -->
                <div
                    id="lanyard-attach-point"
                    class="absolute top-0 left-1/2 -translate-x-1/2 w-1 h-1 bg-transparent"
                >
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- THE ACRYLIC BADGE CASING (FROSTED POLYCARBONATE) -->
        <!-- ========================================== -->
        <div
            class="relative w-full rounded-[26px] bg-white/70 p-2.5 backdrop-blur-xl border border-slate-300/80 shadow-[0_20px_50px_rgba(148,163,184,0.35),inset_0_1px_1px_rgba(255,255,255,0.9)] dark:bg-slate-950/40 dark:border-white/20 dark:shadow-[0_20px_50px_rgba(0,0,0,0.8),inset_0_1px_1px_rgba(255,255,255,0.4),inset_0_-1px_1px_rgba(0,0,0,0.6)] transform-style-3d overflow-hidden transition-all duration-300"
        >
            <!-- Top Punched Slot for Lanyard Hook -->
            <div class="relative w-full flex justify-center pb-2 pt-1">
                <div
                    class="w-14 h-3 bg-slate-300/80 dark:bg-black/90 border border-slate-400/50 dark:border-white/20 rounded-full shadow-[inset_0_2px_4px_rgba(0,0,0,0.4),0_1px_1px_rgba(255,255,255,0.2)] flex items-center justify-center"
                >
                    <!-- Beveled hole inner lip -->
                    <div class="w-10 h-1 bg-slate-400 dark:bg-slate-900 rounded-full"></div>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- INNER CARD INSERT (PVC SECURITY PASS) -->
            <!-- ========================================== -->
            <div
                class="relative w-full rounded-2xl bg-gradient-to-b from-white via-slate-50 to-slate-100/95 border border-slate-200/90 p-5 shadow-xl overflow-hidden flex flex-col items-center dark:from-slate-900/95 dark:via-[#0c1022]/95 dark:to-slate-950/98 dark:border-white/15 dark:shadow-2xl transition-all duration-300"
            >
                <!-- Prismatic Holographic Foil Overlay (Reacts dynamically to 3D tilt) -->
                <div
                    id="card-hologram-foil"
                    class="absolute inset-0 pointer-events-none opacity-15 dark:opacity-20 mix-blend-color-dodge transition-opacity duration-200 z-30 rounded-2xl"
                    style="background: linear-gradient(135deg, rgba(255,0,128,0.3), rgba(0,255,255,0.3), rgba(255,255,0,0.3), rgba(138,43,226,0.3)); background-size: 200% 200%;"
                >
                </div>

                <!-- Diagonal Specular Glass Reflection / Glare Sheen -->
                <div
                    id="card-glare"
                    class="absolute inset-0 pointer-events-none opacity-0 z-40 rounded-2xl transition-opacity duration-150"
                    style="background: linear-gradient(115deg, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.08) 35%, rgba(255,255,255,0) 60%);"
                >
                </div>

                <!-- Background Subtle Microgrid Security Pattern -->
                <div
                    class="absolute inset-0 opacity-[0.06] dark:opacity-[0.04] pointer-events-none"
                    style="background-image: radial-gradient(rgba(99, 102, 241, 0.6) 1px, transparent 1px); background-size: 12px 12px;"
                >
                </div>

                <!-- Top Edge Rainbow Hologram Strip -->
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-violet-500 via-cyan-400 via-amber-300 to-fuchsia-500 shadow-[0_0_10px_rgba(6,182,212,0.6)]"></div>

                <!-- ================= HEADER SECTION ================= -->
                <div class="w-full flex items-center justify-between border-b border-slate-200 dark:border-white/10 pb-3 mb-5 z-10">
                    <!-- Left: Access Tier Badge -->
                    <div class="flex items-center gap-2">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.9)]"></span>
                        </span>
                        <span class="text-[10px] font-mono font-bold tracking-[0.2em] text-slate-800 dark:text-slate-200 uppercase">
                            ALL-ACCESS PASS
                        </span>
                    </div>

                    <!-- Right: Contactless RFID Logo & Frequency -->
                    <div class="flex items-center gap-1.5 opacity-80">
                        <span class="text-[8px] font-mono text-slate-500 dark:text-slate-400 tracking-wider">13.56 MHz</span>
                        <svg class="w-3.5 h-3.5 text-cyan-600 dark:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12.55a11 11 0 0 1 14.08 0" stroke-linecap="round"/>
                            <path d="M8.5 15.5a6 6 0 0 1 7 0" stroke-linecap="round"/>
                            <circle cx="12" cy="18" r="1" fill="currentColor"/>
                        </svg>
                    </div>
                </div>

                <!-- ================= PHOTO & SMART CHIP (CLEAN CENTERED) ================= -->
                <div class="relative flex flex-col items-center mb-5 z-10">
                    <!-- Security ID Photo with Frame -->
                    <div class="relative w-24 h-24 sm:w-28 sm:h-28">
                        <!-- Frame Corner Accents -->
                        <div class="absolute -top-1.5 -left-1.5 w-3 h-3 border-t-2 border-l-2 border-cyan-500 dark:border-cyan-400 z-20"></div>
                        <div class="absolute -top-1.5 -right-1.5 w-3 h-3 border-t-2 border-r-2 border-cyan-500 dark:border-cyan-400 z-20"></div>
                        <div class="absolute -bottom-1.5 -left-1.5 w-3 h-3 border-b-2 border-l-2 border-cyan-500 dark:border-cyan-400 z-20"></div>
                        <div class="absolute -bottom-1.5 -right-1.5 w-3 h-3 border-b-2 border-r-2 border-cyan-500 dark:border-cyan-400 z-20"></div>

                        <!-- Photo Container -->
                        <div class="relative w-full h-full rounded-2xl overflow-hidden border border-slate-200 dark:border-white/20 bg-slate-100 dark:bg-slate-800/80 shadow-md">
                            <img
                                src={siteData.profile.avatar}
                                alt={siteData.profile.name}
                                class="w-full h-full object-cover"
                                draggable="false"
                            />
                        </div>

                        <!-- Sleek Gold Smart Chip (Attached at corner of badge photo) -->
                        <div class="absolute -bottom-2 -right-3 w-10 h-8 rounded-md bg-gradient-to-br from-amber-200 via-amber-400 to-yellow-600 p-[1.2px] shadow-[0_4px_12px_rgba(0,0,0,0.5)] z-30">
                            <div class="w-full h-full rounded-[4px] bg-gradient-to-br from-amber-400 via-amber-300 to-yellow-500 border border-amber-700/40 grid grid-cols-3 grid-rows-2 gap-[1px] p-[2px] overflow-hidden">
                                <div class="border-r border-b border-amber-700/40 rounded-tl-xs"></div>
                                <div class="border-b border-amber-700/40"></div>
                                <div class="border-l border-b border-amber-700/40 rounded-tr-xs"></div>
                                <div class="border-r border-amber-700/40 rounded-bl-xs"></div>
                                <div class="bg-amber-500/30"></div>
                                <div class="border-l border-amber-700/40 rounded-br-xs"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================= IDENTITY SECTION ================= -->
                <div class="w-full text-center z-10 mb-4">
                    <h2 class="text-2xl sm:text-3xl font-black font-display text-slate-900 dark:text-white tracking-tight leading-tight mb-2 dark:drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">
                        {siteData.profile.name}
                    </h2>
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary-50 border border-primary-200/90 dark:bg-slate-900/90 dark:border-cyan-400/60 dark:shadow-[0_0_16px_rgba(6,182,212,0.35)] backdrop-blur-md">
                        <span class="w-2 h-2 rounded-full bg-primary-600 dark:bg-cyan-400 shadow-[0_0_8px_rgba(6,182,212,1)] animate-pulse"></span>
                        <span class="text-xs sm:text-[13px] font-mono font-bold text-primary-800 dark:text-cyan-300 tracking-wider uppercase dark:drop-shadow-[0_0_8px_rgba(6,182,212,0.6)]">
                            {siteData.profile.title}
                        </span>
                    </div>
                </div>

                <!-- ================= CLEAN 2-COLUMN STATS GRID ================= -->
                <div class="w-full grid grid-cols-2 gap-3 py-3 px-4 rounded-xl bg-slate-100/90 border border-slate-200 mb-4 z-10 dark:bg-slate-950/60 dark:border-white/10 shadow-inner">
                    <div class="text-center">
                        <span class="block text-[9px] font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-0.5 font-semibold">Experience</span>
                        <span class="text-base sm:text-lg font-bold font-display text-slate-900 dark:text-white">{siteData.profile.years_experience}+ Years</span>
                    </div>
                    <div class="text-center border-l border-slate-200 dark:border-white/10">
                        <span class="block text-[9px] font-mono uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-0.5 font-semibold">Projects</span>
                        <span class="text-base sm:text-lg font-bold font-display text-cyan-600 dark:text-cyan-300">{siteData.profile.projects_completed}+ Shipped</span>
                    </div>
                </div>

                <!-- Microprint Security Text Line -->
                <div class="w-full overflow-hidden text-center opacity-60 dark:opacity-40 mb-4 z-10">
                    <p class="text-[7px] font-mono text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] whitespace-nowrap">
                        • AUTHENTICATED OPERATOR • SYSTEM VERIFIED • 0x8FCA91E •
                    </p>
                </div>

                <!-- ================= FOOTER: AUTHENTIC BARCODE STRIP ================= -->
                <div class="w-full pt-3 border-t border-slate-200 dark:border-white/10 flex items-center justify-between z-10">
                    <!-- Real 1D Barcode Graphic -->
                    <div class="flex items-center gap-[2px] h-7 px-1.5 py-1 bg-white border border-slate-200/60 rounded-xs shadow-xs">
                        <div class="w-[2px] h-full bg-slate-900"></div>
                        <div class="w-[1px] h-full bg-slate-900"></div>
                        <div class="w-[3px] h-full bg-slate-900"></div>
                        <div class="w-[1px] h-full bg-slate-900"></div>
                        <div class="w-[2px] h-full bg-slate-900"></div>
                        <div class="w-[4px] h-full bg-slate-900"></div>
                        <div class="w-[1px] h-full bg-slate-900"></div>
                        <div class="w-[3px] h-full bg-slate-900"></div>
                        <div class="w-[2px] h-full bg-slate-900"></div>
                        <div class="w-[1px] h-full bg-slate-900"></div>
                        <div class="w-[3px] h-full bg-slate-900"></div>
                        <div class="w-[2px] h-full bg-slate-900"></div>
                        <div class="w-[4px] h-full bg-slate-900"></div>
                        <div class="w-[1px] h-full bg-slate-900"></div>
                        <div class="w-[2px] h-full bg-slate-900"></div>
                        <div class="w-[3px] h-full bg-slate-900"></div>
                        <div class="w-[1px] h-full bg-slate-900"></div>
                        <div class="w-[2px] h-full bg-slate-900"></div>
                    </div>

                    <!-- Serial & Security Hash -->
                    <div class="text-right">
                        <span class="block text-[8px] font-mono text-slate-500 dark:text-slate-400 tracking-wider font-medium">SERIAL NO.</span>
                        <span class="block text-[10px] font-mono font-bold text-slate-800 dark:text-slate-200 tracking-widest">
                            ID-8F29-HN-2026
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    class PhysicsCard {
        container: HTMLElement | null = null;
        card: HTMLElement | null = null;
        anchor: HTMLElement | null = null;
        attachPoint: HTMLElement | null = null;
        lanyardSvg: SVGSVGElement | null = null;
        lanyardShadowPath: SVGPathElement | null = null;
        lanyardGlowPath: SVGPathElement | null = null;
        lanyardMainPath: SVGPathElement | null = null;
        lanyardEdgePath: SVGPathElement | null = null;
        lanyardStitchPath: SVGPathElement | null = null;
        glare: HTMLElement | null = null;
        foil: HTMLElement | null = null;
        dropShadow: HTMLElement | null = null;
        animFrameId: number | null = null;
        observer: IntersectionObserver | null = null;
        isInView = true;

        // Cached layout coordinates to eliminate getBoundingClientRect layout thrashing in rAF
        cachedCoords = {
            x1: 0,
            y1: 0,
            restX2: 0,
            restY2: 0,
            valid: false,
        };

        state = {
            pos: { x: 0, y: 0 },
            vel: { x: 0, y: 0 },
            target: { x: 0, y: 0 },
            rot: { x: 0, y: 0 },
            isDragging: false,
            dragOffset: { x: 0, y: 0 },
            touchStartX: 0,
            touchStartY: 0,
            isTouchSwipe: false,
            isTouchScroll: false,
        };

        config = {
            spring: 0.08,
            damping: 0.88,
            dragLag: 0.2,
            tiltSensitivity: 18,
        };

        private boundOnStart = this.onStart.bind(this);
        private boundOnMove = this.onMove.bind(this);
        private boundOnEnd = this.onEnd.bind(this);

        constructor() {
            this.container = document.getElementById('id-card-wrapper');
            this.card = document.getElementById('physics-card');
            this.anchor = document.getElementById('card-anchor');
            this.attachPoint = document.getElementById('lanyard-attach-point');
            this.lanyardSvg = document.getElementById('lanyard-svg') as SVGSVGElement | null;
            this.lanyardShadowPath = document.getElementById('lanyard-shadow-path') as SVGPathElement | null;
            this.lanyardGlowPath = document.getElementById('lanyard-glow-path') as SVGPathElement | null;
            this.lanyardMainPath = document.getElementById('lanyard-main-path') as SVGPathElement | null;
            this.lanyardEdgePath = document.getElementById('lanyard-edge-path') as SVGPathElement | null;
            this.lanyardStitchPath = document.getElementById('lanyard-stitch-path') as SVGPathElement | null;
            this.glare = document.getElementById('card-glare');
            this.foil = document.getElementById('card-hologram-foil');
            this.dropShadow = document.getElementById('card-drop-shadow');

            if (!this.container || !this.card) return;

            this.init();
        }

        setupObserver() {
            if (!this.container || typeof IntersectionObserver === 'undefined') return;
            this.observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        this.isInView = entry.isIntersecting;
                        if (this.isInView) {
                            this.startLoop();
                        } else {
                            this.stopLoop();
                        }
                    });
                },
                { rootMargin: '100px 0px' }
            );
            this.observer.observe(this.container);
        }

        updateCachedCoords() {
            if (!this.anchor || !this.attachPoint || !this.lanyardSvg) return;
            const svgRect = this.lanyardSvg.getBoundingClientRect();
            const anchorRect = this.anchor.getBoundingClientRect();
            const attachRect = this.attachPoint.getBoundingClientRect();

            this.cachedCoords.x1 = anchorRect.left + anchorRect.width / 2 - svgRect.left;
            this.cachedCoords.y1 = anchorRect.top + anchorRect.height / 2 - svgRect.top;
            this.cachedCoords.restX2 = attachRect.left + attachRect.width / 2 - svgRect.left - this.state.pos.x;
            this.cachedCoords.restY2 = attachRect.top + attachRect.height / 2 - svgRect.top - this.state.pos.y;
            this.cachedCoords.valid = true;
        }

        init() {
            if (!this.container) return;

            this.setupObserver();
            this.updateCachedCoords();

            // Bind Events
            this.container.addEventListener('mousedown', this.boundOnStart);
            this.container.addEventListener('touchstart', this.boundOnStart, { passive: true });

            window.addEventListener('mousemove', this.boundOnMove);
            window.addEventListener('touchmove', this.boundOnMove, { passive: true });

            window.addEventListener('mouseup', this.boundOnEnd);
            window.addEventListener('touchend', this.boundOnEnd);
            window.addEventListener('touchcancel', this.boundOnEnd);

            window.addEventListener('resize', () => {
                this.updateCachedCoords();
            });

            this.startLoop();
        }

        startLoop() {
            if (this.animFrameId !== null) return;
            const loop = () => {
                if (!this.isInView) {
                    this.animFrameId = null;
                    return;
                }
                const isMoving = this.updatePhysics();
                this.updateVisuals();
                if (isMoving || this.state.isDragging) {
                    this.animFrameId = requestAnimationFrame(loop);
                } else {
                    this.animFrameId = null;
                }
            };
            this.animFrameId = requestAnimationFrame(loop);
        }

        stopLoop() {
            if (this.animFrameId !== null) {
                cancelAnimationFrame(this.animFrameId);
                this.animFrameId = null;
            }
        }

        destroy() {
            this.stopLoop();
            if (this.observer) {
                this.observer.disconnect();
                this.observer = null;
            }

            if (this.container) {
                this.container.removeEventListener('mousedown', this.boundOnStart);
                this.container.removeEventListener('touchstart', this.boundOnStart);
            }

            window.removeEventListener('mousemove', this.boundOnMove);
            window.removeEventListener('touchmove', this.boundOnMove);
            window.removeEventListener('mouseup', this.boundOnEnd);
            window.removeEventListener('touchend', this.boundOnEnd);
            window.removeEventListener('touchcancel', this.boundOnEnd);
        }

        onStart(e: MouseEvent | TouchEvent) {
            const isTouch = 'touches' in e;
            if (isTouch) {
                if (e.touches.length !== 1) return;
                this.state.touchStartX = e.touches[0].clientX;
                this.state.touchStartY = e.touches[0].clientY;
                this.state.isTouchSwipe = false;
                this.state.isTouchScroll = false;
            }

            this.state.isDragging = !isTouch;
            if (this.container && !isTouch) {
                this.container.style.cursor = 'grabbing';
            }

            const clientX = isTouch ? e.touches[0].clientX : e.clientX;
            const clientY = isTouch ? e.touches[0].clientY : e.clientY;

            this.state.dragOffset.x = clientX - this.state.pos.x;
            this.state.dragOffset.y = clientY - this.state.pos.y;
            this.state.target.x = this.state.pos.x;
            this.state.target.y = this.state.pos.y;
            this.startLoop();
        }

        onMove(e: MouseEvent | TouchEvent) {
            const isTouch = 'touches' in e;
            if (isTouch) {
                if (e.touches.length !== 1 || this.state.isTouchScroll) return;
                const dx = e.touches[0].clientX - this.state.touchStartX;
                const dy = e.touches[0].clientY - this.state.touchStartY;

                if (!this.state.isTouchSwipe && !this.state.isTouchScroll) {
                    if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 6) {
                        this.state.isTouchScroll = true;
                        this.state.isDragging = false;
                        return; // Allow native vertical scroll
                    }
                    if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 6) {
                        this.state.isTouchSwipe = true;
                        this.state.isDragging = true;
                        this.startLoop();
                    }
                }
            }

            if (!this.state.isDragging) return;

            const clientX = isTouch ? e.touches[0].clientX : e.clientX;
            const clientY = isTouch ? e.touches[0].clientY : e.clientY;

            this.state.target.x = clientX - this.state.dragOffset.x;
            this.state.target.y = clientY - this.state.dragOffset.y;
        }

        onEnd() {
            this.state.isDragging = false;
            this.state.isTouchSwipe = false;
            this.state.isTouchScroll = false;
            if (this.container) {
                this.container.style.cursor = 'grab';
            }
            this.startLoop(); // Ensure it springs back to origin before sleeping
        }

        updatePhysics(): boolean {
            if (this.state.isDragging) {
                const dx = this.state.target.x - this.state.pos.x;
                const dy = this.state.target.y - this.state.pos.y;

                this.state.vel.x = dx * this.config.dragLag;
                this.state.vel.y = dy * this.config.dragLag;

                this.state.pos.x += this.state.vel.x;
                this.state.pos.y += this.state.vel.y;

                this.state.rot.y = Math.max(-30, Math.min(30, this.state.vel.x * 1.3));
                this.state.rot.x = Math.max(-30, Math.min(30, -this.state.vel.y * 1.3));
                return true;
            } else {
                const forceX = -this.state.pos.x * this.config.spring;
                const forceY = -this.state.pos.y * this.config.spring;

                this.state.vel.x += forceX;
                this.state.vel.y += forceY;

                this.state.vel.x *= this.config.damping;
                this.state.vel.y *= this.config.damping;

                this.state.pos.x += this.state.vel.x;
                this.state.pos.y += this.state.vel.y;

                this.state.rot.x = -this.state.pos.y * 0.1;
                this.state.rot.y = this.state.pos.x * 0.1;

                // Check if settled to rest
                const speed = Math.hypot(this.state.vel.x, this.state.vel.y);
                const dist = Math.hypot(this.state.pos.x, this.state.pos.y);
                if (speed < 0.05 && dist < 0.05) {
                    this.state.pos.x = 0;
                    this.state.pos.y = 0;
                    this.state.vel.x = 0;
                    this.state.vel.y = 0;
                    this.state.rot.x = 0;
                    this.state.rot.y = 0;
                    return false; // Settled -> sleep rAF
                }
                return true;
            }
        }

        updateVisuals() {
            const { x, y } = this.state.pos;
            const { x: rx, y: ry } = this.state.rot;

            // Apply 3D Transform
            if (this.card) {
                this.card.style.transform = `
                    translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) 
                    rotateX(${rx.toFixed(1)}deg) 
                    rotateY(${ry.toFixed(1)}deg)
                `;
            }

            // Prismatic foil & glare sheen (smooth)
            if (this.foil) {
                const foilPos = 50 + rx * 2 + ry * 2;
                this.foil.style.backgroundPosition = `${foilPos.toFixed(0)}% ${foilPos.toFixed(0)}%`;
            }

            if (this.glare) {
                const glareX = 50 + ry * 2;
                const glareY = 50 - rx * 2;
                this.glare.style.backgroundPosition = `${glareX.toFixed(0)}% ${glareY.toFixed(0)}%`;
            }

            if (this.dropShadow) {
                const shadowX = -x * 0.2;
                const shadowY = 25 - y * 0.15;
                this.dropShadow.style.transform = `translate3d(${shadowX.toFixed(1)}px, ${shadowY.toFixed(1)}px, 0)`;
            }

            // Lanyard strap update with cached coordinates (No forced reflow!)
            if (this.cachedCoords.valid) {
                const x1 = this.cachedCoords.x1;
                const y1 = this.cachedCoords.y1;
                const x2 = this.cachedCoords.restX2 + x;
                const y2 = this.cachedCoords.restY2 + y;

                const dx = x2 - x1;
                const dy = y2 - y1;
                const dist = Math.hypot(dx, dy);
                const restDist = 170;

                const midX = (x1 + x2) / 2;
                const midY = (y1 + y2) / 2;

                const slack = Math.max(0, restDist - dist) * 0.5;
                const ctrlX = midX + this.state.vel.x * 0.18;
                const ctrlY = midY + slack - this.state.vel.y * 0.12;

                const pathData = `M ${x1.toFixed(1)} ${y1.toFixed(1)} Q ${ctrlX.toFixed(1)} ${ctrlY.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`;
                const shadowPathData = `M ${x1.toFixed(1)} ${(y1 + 10).toFixed(1)} Q ${ctrlX.toFixed(1)} ${(ctrlY + 12).toFixed(1)} ${x2.toFixed(1)} ${(y2 + 8).toFixed(1)}`;

                if (this.lanyardShadowPath) this.lanyardShadowPath.setAttribute('d', shadowPathData);
                if (this.lanyardGlowPath) this.lanyardGlowPath.setAttribute('d', pathData);
                if (this.lanyardMainPath) this.lanyardMainPath.setAttribute('d', pathData);
                if (this.lanyardEdgePath) this.lanyardEdgePath.setAttribute('d', pathData);
                if (this.lanyardStitchPath) this.lanyardStitchPath.setAttribute('d', pathData);
            }
        }
    }

    // Single-instance lifecycle
    function initPhysicsCard() {
        if ((window as any).__physicsCardInstance) {
            (window as any).__physicsCardInstance.destroy();
        }
        (window as any).__physicsCardInstance = new PhysicsCard();
    }

    document.addEventListener('astro:page-load', initPhysicsCard);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPhysicsCard);
    } else {
        initPhysicsCard();
    }
</script>

