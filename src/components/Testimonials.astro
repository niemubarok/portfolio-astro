---
import testimonialsData from '../data/testimonials.json';

const testimonials = testimonialsData.sort((a, b) => a.order - b.order);

// Helper for distinct initial avatar gradient
const avatarGradients = [
    'from-cyan-500 to-blue-600',
    'from-purple-500 to-indigo-600',
    'from-emerald-500 to-teal-600',
    'from-amber-500 to-orange-600',
];
---

<div class="relative group/carousel w-full">
    <!-- Carousel Window with Faded Mask Edges -->
    <div class="skill-carousel-window overflow-hidden w-full py-4">
        <div class="testimonial-track flex gap-6 sm:gap-8 px-4 items-stretch">
            {/* First Set of Cards */}
            {
                testimonials.map((item, index) => (
                    <div
                        class="group/card relative flex flex-col justify-between w-[320px] sm:w-[400px] md:w-[460px] flex-shrink-0 rounded-3xl border border-slate-200/90 bg-white/85 p-6 sm:p-8 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1.5 hover:border-primary-500/50 hover:shadow-xl hover:shadow-primary-500/10 dark:border-white/10 dark:bg-slate-950/60 dark:hover:border-primary-400/40 dark:hover:shadow-primary-500/5"
                    >
                        <!-- Background Quote Watermark -->
                        <div class="absolute top-6 right-6 text-slate-200/70 dark:text-white/[0.03] pointer-events-none transition-colors group-hover/card:text-primary-500/15 dark:group-hover/card:text-primary-400/10">
                            <svg
                                class="w-14 h-14 sm:w-16 sm:h-16"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                            </svg>
                        </div>

                        <div class="relative z-10">
                            <!-- Rating Stars & Verified Tag -->
                            <div class="flex items-center justify-between gap-2 mb-4">
                                <div class="flex items-center gap-1 text-amber-400 dark:text-amber-300">
                                    {Array.from({ length: item.rating }).map(() => (
                                        <svg
                                            class="w-4 h-4 fill-current"
                                            viewBox="0 0 20 20"
                                        >
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                        </svg>
                                    ))}
                                </div>

                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-medium tracking-wide bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-500/30">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                    Verified Client
                                </span>
                            </div>

                            <!-- Testimonial Content -->
                            <p class="text-slate-700 dark:text-slate-300 leading-relaxed text-sm sm:text-base mb-6 font-normal">
                                "{item.content}"
                            </p>
                        </div>

                        <!-- Client Author Info -->
                        <div class="relative z-10 flex items-center gap-3.5 pt-4 border-t border-slate-200/80 dark:border-white/10 mt-auto">
                            <!-- Avatar Initial Monogram -->
                            <div
                                class={`w-11 h-11 rounded-2xl bg-gradient-to-br ${avatarGradients[index % avatarGradients.length]} flex items-center justify-center text-white font-bold font-display text-base shadow-md flex-shrink-0`}
                            >
                                {item.name.charAt(0)}
                            </div>

                            <div class="min-w-0">
                                <h3 class="font-display font-bold text-slate-900 dark:text-white text-base leading-snug truncate">
                                    {item.name}
                                </h3>
                                <p class="text-xs font-mono text-slate-500 dark:text-slate-400 truncate">
                                    <span class="text-primary-600 dark:text-cyan-400 font-medium">{item.position}</span>
                                    <span class="mx-1 opacity-60">•</span>
                                    <span>{item.company}</span>
                                </p>
                            </div>
                        </div>
                    </div>
                ))
            }

            {/* Duplicate Set for Seamless Infinite Loop */}
            {
                testimonials.map((item, index) => (
                    <div
                        class="group/card relative flex flex-col justify-between w-[320px] sm:w-[400px] md:w-[460px] flex-shrink-0 rounded-3xl border border-slate-200/90 bg-white/85 p-6 sm:p-8 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1.5 hover:border-primary-500/50 hover:shadow-xl hover:shadow-primary-500/10 dark:border-white/10 dark:bg-slate-950/60 dark:hover:border-primary-400/40 dark:hover:shadow-primary-500/5"
                        aria-hidden="true"
                    >
                        <!-- Background Quote Watermark -->
                        <div class="absolute top-6 right-6 text-slate-200/70 dark:text-white/[0.03] pointer-events-none transition-colors group-hover/card:text-primary-500/15 dark:group-hover/card:text-primary-400/10">
                            <svg
                                class="w-14 h-14 sm:w-16 sm:h-16"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                            </svg>
                        </div>

                        <div class="relative z-10">
                            <!-- Rating Stars & Verified Tag -->
                            <div class="flex items-center justify-between gap-2 mb-4">
                                <div class="flex items-center gap-1 text-amber-400 dark:text-amber-300">
                                    {Array.from({ length: item.rating }).map(() => (
                                        <svg
                                            class="w-4 h-4 fill-current"
                                            viewBox="0 0 20 20"
                                        >
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                        </svg>
                                    ))}
                                </div>

                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-medium tracking-wide bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-500/30">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                    Verified Client
                                </span>
                            </div>

                            <!-- Testimonial Content -->
                            <p class="text-slate-700 dark:text-slate-300 leading-relaxed text-sm sm:text-base mb-6 font-normal">
                                "{item.content}"
                            </p>
                        </div>

                        <!-- Client Author Info -->
                        <div class="relative z-10 flex items-center gap-3.5 pt-4 border-t border-slate-200/80 dark:border-white/10 mt-auto">
                            <!-- Avatar Initial Monogram -->
                            <div
                                class={`w-11 h-11 rounded-2xl bg-gradient-to-br ${avatarGradients[index % avatarGradients.length]} flex items-center justify-center text-white font-bold font-display text-base shadow-md flex-shrink-0`}
                            >
                                {item.name.charAt(0)}
                            </div>

                            <div class="min-w-0">
                                <h3 class="font-display font-bold text-slate-900 dark:text-white text-base leading-snug truncate">
                                    {item.name}
                                </h3>
                                <p class="text-xs font-mono text-slate-500 dark:text-slate-400 truncate">
                                    <span class="text-primary-600 dark:text-cyan-400 font-medium">{item.position}</span>
                                    <span class="mx-1 opacity-60">•</span>
                                    <span>{item.company}</span>
                                </p>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</div>

<style>
    @keyframes scrollTestimonials {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(calc(-50% - 1rem));
        }
    }

    .testimonial-track {
        display: flex;
        width: max-content;
        animation: scrollTestimonials 32s linear infinite;
    }

    .testimonial-track:hover {
        animation-play-state: paused;
    }
</style>
