---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HolographicID from '../components/HolographicID.astro';
import ProjectCard3D from '../components/ProjectCard3D.astro';
import FloatingTech from '../components/FloatingTech.astro';
import TechBackground from '../components/TechBackground.astro';
import CodeBackground from '../components/CodeBackground.astro';
import SpaceBackground from '../components/SpaceBackground.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import { getCollection } from 'astro:content';
import skills from '../data/skills.json';
import siteData from '../data/site.json';
import FloatingWhatsAppProject from '../components/FloatingWhatsApp.astro';

// Get sorted projects
const projects = (await getCollection('projects'))
    .sort((a, b) => a.data.order - b.data.order)
    .slice(0, 6); // Top 3 projects

const featuredSkills = skills.filter((skill) =>
    [
        'HTML/CSS',
        'JavaScript',
        'TypeScript',
        'Vue.js',
        'React',
        'Next.js',
        'Astro',
        'Tailwind CSS',
        'PHP',
        'Laravel',
        'Node.js',
        'Go',
        'MySQL',
        'PostgreSQL',
        'Docker',
        'AWS',
        'Podman',
        'CouchDB',
        'DuckDB',
        'Git',
        'GitHub Copilot',
        'VS Code'
    ].includes(skill.name)
);
---

<Layout title={`${siteData.profile.name} - ${siteData.profile.title}`}>
    <Navbar />

    <main class="overflow-hidden">
        <!-- Hero Section (Artistic Asymmetry) -->
        <section
            class="relative min-h-screen w-full overflow-hidden flex items-center justify-center perspective-1000 bg-dark-bg py-20 lg:py-0"
        >
            <!-- Dynamic Space Background -->
            <SpaceBackground />

            <!-- Parallax Tech Background: Code Mode -->
            <TechBackground theme="code" speed={0.2} direction="up" />

            <!-- Artistic Decor: Abstract Blobs -->
            <div
                class="absolute top-[-10%] right-[-10%] w-[500px] h-[500px] bg-primary-500/20 rounded-full blur-[120px] mix-blend-screen animate-float"
            >
            </div>
            <div
                class="absolute bottom-[-10%] left-[-10%] w-[600px] h-[600px] bg-purple-600/10 rounded-full blur-[150px] mix-blend-screen animate-float"
                style="animation-delay: 2s"
            >
            </div>

            <!-- Massive Artistic Typography (Background) -->
            <!-- <div
                class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full flex items-center justify-center pointer-events-none select-none z-0"
            >
                <span
                    class="text-[20vw] font-black font-display text-transparent bg-clip-text bg-gradient-to-r from-fuchsia-500/5 via-red-500/5 to-yellow-500/5 leading-none rotate-[-5deg] scale-150 blur-sm mix-blend-overlay"
                >
                    HUSNI
                </span>
            </div>
            <div
                class="absolute top-3/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full flex items-center justify-center pointer-events-none select-none z-0"
            >
                <span
                    class="text-[20vw] font-black font-display text-transparent bg-clip-text bg-gradient-to-r from-lime-400/5 via-cyan-500/5 to-violet-600/5 leading-none rotate-[-5deg] scale-150 blur-sm mix-blend-overlay"
                >
                    MUBAROK
                </span>
            </div> -->

            <div
                class="max-w-7xl w-full mx-auto px-4 z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-12 items-center h-full content-center"
            >
                <!-- Left Content: Asymmetric & Bold -->
                <div
                    class="lg:col-span-7 flex flex-col justify-center relative order-2 lg:order-1 pt-10 lg:pt-0 text-center lg:text-left"
                >
                    <!-- <div
                        class="mb-4 inline-flex self-start px-4 py-2 rounded-full border border-primary-500/30 bg-primary-500/10 backdrop-blur-md text-primary-300 font-mono text-xs uppercase tracking-widest"
                        data-aos="fade-right"
                    >
                        /// System Online
                    </div> -->

                    <h1
                        class="text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-black font-display text-white mb-6 leading-[1.0] lg:leading-[0.9] tracking-tighter"
                        data-aos="fade-up"
                    >
                        Engineering, <br />
                        <span
                            id="dynamic-text"
                            class="text-transparent bg-clip-text bg-neon-gradient glitch relative inline-block whitespace-nowrap"
                            data-text="AI Product Engineering."
                            >AI Product Engineering.</span
                        >
                    </h1>

                    <p
                        id="typing-desc"
                        class="text-lg sm:text-xl text-slate-400 max-w-xl leading-relaxed mb-8 sm:mb-10 lg:border-l-4 lg:border-primary-500 lg:pl-6 mx-auto lg:mx-0 min-h-[84px] lg:min-h-[84px]"
                        data-aos="fade-up"
                        data-aos-delay="100"
                    >
                    </p>

                    <script>
                        // Dynamic Text Rotator
                        const phrases = [
                            'AI Product Engineering.',
                            'LLM Experiences.',
                            'Full Stack Mastery.',
                            'Scalable Systems.',
                            'Cloud & Automation.',
                        ];
                        let index = 0;
                        const el = document.getElementById('dynamic-text');

                        if (el) {
                            setInterval(() => {
                                index = (index + 1) % phrases.length;
                                el.textContent = phrases[index];
                                el.setAttribute('data-text', phrases[index]);
                            }, 1000);
                        }

                        // Typing Animation for Description
                        const descText =
                            'I build AI-enabled products, LLM workflows, and modern digital experiences—combining backend reliability, UX polish, and developer tooling to turn ideas into scalable, production-ready solutions.';
                        const descEl = document.getElementById('typing-desc');

                        if (descEl) {
                            let charIndex = 0;

                            function typeWriter() {
                                if (charIndex < descText.length) {
                                    descEl!.textContent +=
                                        descText.charAt(charIndex);
                                    charIndex++;
                                    setTimeout(typeWriter, 15); // Typing speed
                                } else {
                                    // Optional: Add blinking cursor at the end
                                    descEl!.innerHTML +=
                                        '<span class="animate-pulse">|</span>';
                                }
                            }

                            // Start typing after a slight delay
                            setTimeout(typeWriter, 500);
                        }
                    </script>

                    <div
                        class="flex flex-wrap gap-4 sm:gap-6 justify-center lg:justify-start"
                        data-aos="fade-up"
                        data-aos-delay="200"
                    >
                        <a
                            href="#projects"
                            class="relative px-6 sm:px-8 py-3 sm:py-4 rounded-full bg-gradient-to-r from-primary-600 to-purple-600 text-white font-bold text-base sm:text-lg shadow-lg hover:shadow-neon hover:scale-105 transition-all duration-300 flex items-center gap-2 group"
                        >
                            <span>View Gallery</span>
                            <svg
                                class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
                            >
                        </a>
                        <a
                            href="#contact"
                            class="px-6 sm:px-8 py-3 sm:py-4 rounded-full border border-white/10 bg-white/5 text-white font-bold text-base sm:text-lg hover:bg-white/10 hover:border-white/30 transition-all backdrop-blur-sm hover:scale-105"
                        >
                            Connect
                        </a>
                    </div>
                </div>

                <!-- Right Content: Floating Artifacts -->
                <div
                    class="lg:col-span-5 relative flex justify-center items-center h-full order-1 lg:order-2 perspective-1000"
                >
                    <!-- Floating Tech (Background of ID) -->
                    <div
                        class="absolute inset-0 flex items-center justify-center -z-10 opacity-50 scale-100 lg:scale-150"
                    >
                        <FloatingTech />
                    </div>

                    <!-- Tilted ID Card -->
                    <div
                        class="transform rotate-y-[-15deg] rotate-x-[5deg] hover:rotate-0 transition-transform duration-700 ease-out w-[85%] sm:w-full max-w-[300px] lg:max-w-none mb-16 lg:mb-0"
                        data-tilt
                    >
                        <HolographicID />
                    </div>
                </div>
            </div>
        </section>

        <!-- Projects Section (3D Tilt Cards) -->
        <section id="projects" class="py-20 lg:py-32 relative overflow-hidden bg-dark-bg/30">
            <!-- Parallax Tech Background: Grid Mode -->
            <TechBackground theme="grid" speed={0.15} direction="down" />

            <div
                class="absolute top-0 right-0 w-[500px] h-[500px] bg-purple-600/10 rounded-full blur-[100px] pointer-events-none"
            >
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div
                    class="flex flex-col md:flex-row justify-between items-end mb-16 gap-4 text-center md:text-left"
                >
                    <div data-aos="fade-right" class="w-full md:w-auto">
                        <h2
                            class="text-4xl font-bold font-display text-white mb-4"
                        >
                            Featured Projects
                        </h2>
                        <p class="text-slate-400">
                            Selected works that showcase technical mastery.
                        </p>
                    </div>
                    <a
                        href="/projects"
                        class="text-primary-400 hover:text-white transition-colors flex items-center gap-2 mx-auto md:mx-0"
                    >
                        View All <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
                        >
                    </a>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 md:gap-16 lg:gap-20"
                >
                    {
                        projects.map((project, index) => (
                            <div
                                data-aos="fade-up"
                                data-aos-delay={index * 100}
                            >
                                <ProjectCard3D project={project} />
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Skills Section (Glass Cards) -->
        <section
            id="skills"
            class="py-20 lg:py-24 bg-dark-bg/30 relative overflow-hidden"
        >
            <!-- Parallax Tech Background: Binary Mode -->
            <TechBackground theme="binary" speed={0.1} direction="up" />

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <h2
                    class="text-3xl font-bold font-display text-white text-center mb-4 lg:mb-6"
                    data-aos="zoom-in"
                >
                    Technologies & Arsenal
                </h2>
                <p class="text-center text-slate-400 max-w-2xl mx-auto mb-12 lg:mb-16">
                    From AI-assisted product workflows and prototyping to backend architecture, cloud deployment, and developer tooling.
                </p>

                {/* Carousel Container with Faded Edges */}
                <div class="relative group space-y-12">
                    {/* Row 1 */}
                    <div class="relative h-32 flex items-center">
                        {/* Carousel Track */}
                        <div class="skill-carousel-window overflow-hidden w-full">
                            <div class="flex gap-8 lg:gap-12 px-4" style="animation: scroll 40s linear infinite;">
                                {
                                    featuredSkills.slice(0, Math.ceil(featuredSkills.length / 2)).map((skill, index) => (
                                        <div
                                            class="group/item flex flex-col items-center gap-3 flex-shrink-0 transition-all duration-300 hover:opacity-100"
                                            style={`animation: fadeInUp 0.8s ease-out forwards; animation-delay: ${index * 80}ms;`}
                                        >
                                            <div class="relative h-20 w-20 flex items-center justify-center">
                                                {skill.name === 'Wails' ? (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        viewBox="0 0 24 24"
                                                        width="56"
                                                        height="56"
                                                        fill="currentColor"
                                                        class="text-slate-400 group-hover/item:text-primary-400 transition-all duration-300 drop-shadow-lg group-hover/item:scale-125 group-hover/item:filter group-hover/item:drop-shadow-[0_0_12px_rgba(139,92,246,0.6)]"
                                                        aria-label="Wails logo"
                                                    >
                                                        <path d="m19.67 5.252l-7.856 5.039l-.369-.459l-8.69-.283l1.891 1.904l5.221.106l1.63 1.656l-5.878.662l1.77 1.783l5.34-1.185l.003-.006l.993 1.168l-3.079 3.11l7.399.001l-1.582-5.002l2.209 3.14H24l-5.385-2.415h4.121l-5.384-2.418h4.117L16.297 9.73l1.088-1.443l4.09-1.076l-3.467.248zm-3.635 2.322l-6.039.43l1.455 1.826l1.813-.476zm-.252 2.84l-.86 1.145l-.001-.002l.154-.205zM0 12.2l5.615 1.033l-1.017-1.027z"/>
                                                    </svg>
                                                ) : (
                                                    <i
                                                        class={`${skill.icon} text-6xl text-slate-400 group-hover/item:text-primary-400 transition-all duration-300 drop-shadow-lg group-hover/item:scale-125 group-hover/item:filter group-hover/item:drop-shadow-[0_0_12px_rgba(139,92,246,0.6)]`}
                                                    />
                                                )}
                                            </div>
                                            <span class="text-sm font-semibold text-slate-300 group-hover/item:text-primary-300 transition-colors duration-300 whitespace-nowrap text-center">
                                                {skill.name}
                                            </span>
                                        </div>
                                    ))
                                }
                                {/* Duplicate for seamless loop */}
                                {
                                    featuredSkills.slice(0, Math.ceil(featuredSkills.length / 2)).map((skill, index) => (
                                        <div
                                            class="group/item flex flex-col items-center gap-3 flex-shrink-0 transition-all duration-300 hover:opacity-100"
                                        >
                                            <div class="relative h-20 w-20 flex items-center justify-center">
                                                {skill.name === 'Wails' ? (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        viewBox="0 0 24 24"
                                                        width="56"
                                                        height="56"
                                                        fill="currentColor"
                                                        class="text-slate-400 group-hover/item:text-primary-400 transition-all duration-300 drop-shadow-lg group-hover/item:scale-125 group-hover/item:filter group-hover/item:drop-shadow-[0_0_12px_rgba(139,92,246,0.6)]"
                                                        aria-label="Wails logo"
                                                    >
                                                        <path d="m19.67 5.252l-7.856 5.039l-.369-.459l-8.69-.283l1.891 1.904l5.221.106l1.63 1.656l-5.878.662l1.77 1.783l5.34-1.185l.003-.006l.993 1.168l-3.079 3.11l7.399.001l-1.582-5.002l2.209 3.14H24l-5.385-2.415h4.121l-5.384-2.418h4.117L16.297 9.73l1.088-1.443l4.09-1.076l-3.467.248zm-3.635 2.322l-6.039.43l1.455 1.826l1.813-.476zm-.252 2.84l-.86 1.145l-.001-.002l.154-.205zM0 12.2l5.615 1.033l-1.017-1.027z"/>
                                                    </svg>
                                                ) : (
                                                    <i
                                                        class={`${skill.icon} text-6xl text-slate-400 group-hover/item:text-primary-400 transition-all duration-300 drop-shadow-lg group-hover/item:scale-125 group-hover/item:filter group-hover/item:drop-shadow-[0_0_12px_rgba(139,92,246,0.6)]`}
                                                    />
                                                )}
                                            </div>
                                            <span class="text-sm font-semibold text-slate-300 group-hover/item:text-primary-300 transition-colors duration-300 whitespace-nowrap text-center">
                                                {skill.name}
                                            </span>
                                        </div>
                                    ))
                                }
                            </div>
                        </div>
                    </div>

                    {/* Row 2 */}
                    <div class="relative h-32 flex items-center">
                        {/* Carousel Track */}
                        <div class="skill-carousel-window overflow-hidden w-full">
                            <div class="flex gap-8 lg:gap-12 px-4" style="animation: scroll-reverse 40s linear infinite;">
                                {
                                    featuredSkills.slice(Math.ceil(featuredSkills.length / 2)).map((skill, index) => (
                                        <div
                                            class="group/item flex flex-col items-center gap-3 flex-shrink-0 transition-all duration-300 hover:opacity-100"
                                            style={`animation: fadeInUp 0.8s ease-out forwards; animation-delay: ${index * 80}ms;`}
                                        >
                                            <div class="relative h-20 w-20 flex items-center justify-center">
                                                {skill.name === 'Wails' ? (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        viewBox="0 0 24 24"
                                                        width="56"
                                                        height="56"
                                                        fill="currentColor"
                                                        class="text-slate-400 group-hover/item:text-primary-400 transition-all duration-300 drop-shadow-lg group-hover/item:scale-125 group-hover/item:filter group-hover/item:drop-shadow-[0_0_12px_rgba(139,92,246,0.6)]"
                                                        aria-label="Wails logo"
                                                    >
                                                        <path d="m19.67 5.252l-7.856 5.039l-.369-.459l-8.69-.283l1.891 1.904l5.221.106l1.63 1.656l-5.878.662l1.77 1.783l5.34-1.185l.003-.006l.993 1.168l-3.079 3.11l7.399.001l-1.582-5.002l2.209 3.14H24l-5.385-2.415h4.121l-5.384-2.418h4.117L16.297 9.73l1.088-1.443l4.09-1.076l-3.467.248zm-3.635 2.322l-6.039.43l1.455 1.826l1.813-.476zm-.252 2.84l-.86 1.145l-.001-.002l.154-.205zM0 12.2l5.615 1.033l-1.017-1.027z"/>
                                                    </svg>
                                                ) : (
                                                    <i
                                                        class={`${skill.icon} text-6xl text-slate-400 group-hover/item:text-primary-400 transition-all duration-300 drop-shadow-lg group-hover/item:scale-125 group-hover/item:filter group-hover/item:drop-shadow-[0_0_12px_rgba(139,92,246,0.6)]`}
                                                    />
                                                )}
                                            </div>
                                            <span class="text-sm font-semibold text-slate-300 group-hover/item:text-primary-300 transition-colors duration-300 whitespace-nowrap text-center">
                                                {skill.name}
                                            </span>
                                        </div>
                                    ))
                                }
                                {/* Duplicate for seamless loop */}
                                {
                                    featuredSkills.slice(Math.ceil(featuredSkills.length / 2)).map((skill, index) => (
                                        <div
                                            class="group/item flex flex-col items-center gap-3 flex-shrink-0 transition-all duration-300 hover:opacity-100"
                                        >
                                            <div class="relative h-20 w-20 flex items-center justify-center">
                                                {skill.name === 'Wails' ? (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        viewBox="0 0 24 24"
                                                        width="56"
                                                        height="56"
                                                        fill="currentColor"
                                                        class="text-slate-400 group-hover/item:text-primary-400 transition-all duration-300 drop-shadow-lg group-hover/item:scale-125 group-hover/item:filter group-hover/item:drop-shadow-[0_0_12px_rgba(139,92,246,0.6)]"
                                                        aria-label="Wails logo"
                                                    >
                                                        <path d="m19.67 5.252l-7.856 5.039l-.369-.459l-8.69-.283l1.891 1.904l5.221.106l1.63 1.656l-5.878.662l1.77 1.783l5.34-1.185l.003-.006l.993 1.168l-3.079 3.11l7.399.001l-1.582-5.002l2.209 3.14H24l-5.385-2.415h4.121l-5.384-2.418h4.117L16.297 9.73l1.088-1.443l4.09-1.076l-3.467.248zm-3.635 2.322l-6.039.43l1.455 1.826l1.813-.476zm-.252 2.84l-.86 1.145l-.001-.002l.154-.205zM0 12.2l5.615 1.033l-1.017-1.027z"/>
                                                    </svg>
                                                ) : (
                                                    <i
                                                        class={`${skill.icon} text-6xl text-slate-400 group-hover/item:text-primary-400 transition-all duration-300 drop-shadow-lg group-hover/item:scale-125 group-hover/item:filter group-hover/item:drop-shadow-[0_0_12px_rgba(139,92,246,0.6)]`}
                                                    />
                                                )}
                                            </div>
                                            <span class="text-sm font-semibold text-slate-300 group-hover/item:text-primary-300 transition-colors duration-300 whitespace-nowrap text-center">
                                                {skill.name}
                                            </span>
                                        </div>
                                    ))
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Career Timeline Section -->
        <section id="career" class="py-20 lg:py-24 relative overflow-hidden bg-dark-bg/20">
            <!-- Parallax Tech Background: Circuit Mode -->
            <TechBackground theme="circuit" speed={0.1} direction="down" />

            <div
                class="absolute top-1/2 left-0 w-[500px] h-[500px] bg-primary-900/10 rounded-full blur-[120px] pointer-events-none -translate-y-1/2"
            >
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="text-center mb-10 lg:mb-16" data-aos="fade-up">
                    <h2
                        class="text-3xl md:text-4xl font-bold font-display text-white mb-4"
                    >
                        Career Journey
                    </h2>
                    <p class="text-slate-400 max-w-2xl mx-auto">
                        My professional path and the milestones that defined it.
                    </p>
                </div>

                <CareerTimeline />
            </div>
        </section>

        <!-- Contact Section -->
        <section id="contact" class="py-20 lg:py-32 relative overflow-hidden bg-dark-bg/30">
            <div
                class="absolute bottom-0 left-0 w-full h-[500px] bg-gradient-to-t from-primary-900/20 to-transparent pointer-events-none"
            >
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-12 lg:gap-24 items-start">
                    <!-- Contact Info -->
                    <div
                        class="order-2 lg:order-1 pt-2"
                        data-aos="fade-right"
                    >
                        <p class="mb-4 font-mono text-sm uppercase tracking-[0.24em] text-primary-400">Start a conversation</p>
                        <h2 class="max-w-xl text-4xl md:text-5xl font-bold font-display leading-[0.98] text-white">
                            Have a challenge?<br />
                            <span class="text-slate-500">Let's build it.</span>
                        </h2>
                        <p class="mt-6 max-w-md text-base leading-relaxed text-slate-400">
                            Tell me what you are working on, where it is stuck, or where you want to take it next.
                        </p>

                        <div class="mt-10 border-l border-primary-400/50 pl-5">
                            <p class="mb-2 text-xs font-mono uppercase tracking-widest text-slate-500">Available for</p>
                            <p class="text-lg text-slate-200">AI product prototypes, workflow automation, and full-stack product builds.</p>
                        </div>

                    </div>

                    <!-- Contact Form -->
                    <div
                        class="order-1 lg:order-2 relative overflow-hidden rounded-[2rem] border border-white/15 bg-slate-950/65 p-7 shadow-2xl shadow-black/20 backdrop-blur-xl md:p-10"
                        data-aos="zoom-in-left"
                    >
                        <div class="absolute -right-24 -top-24 h-64 w-64 rounded-full bg-primary-500/15 blur-3xl pointer-events-none"></div>
                        <div class="relative z-10 mb-8 flex items-center justify-between gap-4 border-b border-white/10 pb-6">
                            <div>
